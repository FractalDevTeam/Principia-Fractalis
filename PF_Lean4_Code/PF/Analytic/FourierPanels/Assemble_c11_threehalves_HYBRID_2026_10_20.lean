theorem gate1_arithmetic_hybrid {epsOm : ℝ} (hEps : epsOm ≤ 1 / 10 ^ 21) :
    (121 : ℝ) * ((325512990929/40960000000000 : ℝ) + 7 / 10 ^ 7 + 12 / 10 ^ 8 + epsOm)
      + (11 : ℝ) * ((5302050333/8192000000000 : ℝ) + 7 / 10 ^ 7 + 12 / 10 ^ 8 + epsOm)
      ≤ 484413063734423828191/500000000000000000000 := by
  nlinarith [hEps]

end

