    applied to the identity (monotone) function. -/
lemma mem_approx_union_of_Icc
    {a b : ℝ} {A B : _root_.Interval}
    (hA : a ∈ approx A) (hB : b ∈ approx B)
    {u : ℝ} (hu : u ∈ Set.Icc a b) :
