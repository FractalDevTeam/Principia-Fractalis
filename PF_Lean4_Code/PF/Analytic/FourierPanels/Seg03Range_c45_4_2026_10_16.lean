    u ∈ approx (A ∪ B) := by
  have hmono : MonotoneOn (fun x : ℝ => x) (Set.Icc a b) :=
    fun _ _ _ _ hxy => hxy
  exact _root_.Interval.mem_approx_of_monotone' (f := fun x => x) hmono hu A B hA hB

