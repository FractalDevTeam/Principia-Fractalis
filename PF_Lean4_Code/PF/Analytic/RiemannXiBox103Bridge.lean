/-! ## Section B.7 -- coefficient enclosures, r331a box enclosures, and the
unconditional box-103 top-edge bound -/

theorem box103_A_lo_bound :
    ∀ σ : ℝ, (23/32 : ℝ) ≤ σ → σ ≤ 3/4 → (-(230607/1024) : ℝ) ≤ σ * (σ - 1) - (15 : ℝ) ^ 2 := by
  intro σ h0 h1
  nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ σ - (23/32 : ℝ))
    (by linarith : (0 : ℝ) ≤ σ + (23/32 : ℝ) - 1)]

theorem box103_A_hi_bound :
    ∀ σ : ℝ, (23/32 : ℝ) ≤ σ → σ ≤ 3/4 → σ * (σ - 1) - (15 : ℝ) ^ 2 ≤ (-(3603/16) : ℝ) := by
  intro σ h0 h1
  nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ (3/4 : ℝ) - σ)
    (by linarith : (0 : ℝ) ≤ σ + (3/4 : ℝ) - 1)]

theorem box103_B_lo_bound :
    ∀ σ : ℝ, (23/32 : ℝ) ≤ σ → σ ≤ 3/4 → (105/16 : ℝ) ≤ (15 : ℝ) * (2 * σ - 1) := by
  intro σ h0 h1; linarith

theorem box103_B_hi_bound :
    ∀ σ : ℝ, (23/32 : ℝ) ≤ σ → σ ≤ 3/4 → (15 : ℝ) * (2 * σ - 1) ≤ (15/2 : ℝ) := by
  intro σ h0 h1; linarith

theorem box103_re_enclosure :
    PrincipiaTractalis.RiemannXiThetaBoxEnclosure.BoxReEnclosure
      (23/32 : ℝ) (3/4) 15 (443946867/100000000000) (1) := by
  constructor
  intro σ h0 h1
  refine ⟨?_, ?_⟩
  · have := re_Lambda0_lower σ h0 h1
    linarith
  · have := re_Lambda0_upper σ h0 h1
    linarith

theorem box103_im_enclosure :
    PrincipiaTractalis.RiemannXiThetaBoxEnclosure.BoxImEnclosure
      (23/32 : ℝ) (3/4) 15 (21816839/200000000000) (72400313/250000000000) := by
  constructor
  intro σ h0 h1
  refine ⟨?_, ?_⟩
  · have := im_Lambda0_lower σ h0 h1
    linarith
  · have := im_Lambda0_upper σ h0 h1
    linarith

/-- Worst-case arithmetic over the box rectangle.  p1*p2 is maximised at
(Ahi, RE_LO) because Ahi < 0 <= RE_LO; q1*q2 is minimised at (Blo, IM_LO)
because IM_LO >= 0.  Selecting the wrong B endpoint here is the known
soundness trap; it is resolved at generation time from the sign of the
DECLARED IM_LO, never assumed. -/
theorem box103_re_xi_le :
    ∀ σ : ℝ, (23/32 : ℝ) ≤ σ → σ ≤ 3/4 →
      (riemannXiEntire (⟨σ, 15⟩ : ℂ)).re ≤ (-(1371891697/6400000000000) : ℝ) :=
  PrincipiaTractalis.RiemannXiThetaBoxEnclosure.re_xi_upper_bound_from_enclosures
    box103_re_enclosure box103_im_enclosure
    box103_A_lo_bound box103_A_hi_bound
    box103_B_lo_bound box103_B_hi_bound
    (-(1371891697/6400000000000) : ℝ)
    (by
      intro p1 p2 q1 q2 hp1lo hp1hi hp2lo hp2hi hq1lo hq1hi hq2lo hq2hi
      have hp2nn : (0 : ℝ) ≤ p2 := le_trans (by norm_num) hp2lo
      have hq1nn : (0 : ℝ) ≤ q1 := le_trans (by norm_num) hq1lo
      have hA1 : p1 * p2 ≤ (-(3603/16) : ℝ) * p2 :=
        mul_le_mul_of_nonneg_right hp1hi hp2nn
      have hA2 : (-(3603/16) : ℝ) * p2 ≤ (-(3603/16) : ℝ) * (443946867/100000000000 : ℝ) :=
        mul_le_mul_of_nonpos_left hp2lo (by norm_num)
      have hQ1 : q1 * (21816839/200000000000 : ℝ) ≤ q1 * q2 :=
        mul_le_mul_of_nonneg_left hq2lo hq1nn
      have hq1bnd : (0 : ℝ) ≤ q1 - (105/16 : ℝ) := by linarith
      have himsgn : (0 : ℝ) ≤ (21816839/200000000000 : ℝ) := by norm_num
      have hQ2 : (105/16 : ℝ) * (21816839/200000000000 : ℝ) ≤ q1 * (21816839/200000000000 : ℝ) := by
        nlinarith [mul_nonneg hq1bnd himsgn]
      have hAval : (-(3603/16) : ℝ) * (443946867/100000000000 : ℝ) = (-(1599540561801/1600000000000) : ℝ) := by norm_num
      have hBval : (105/16 : ℝ) * (21816839/200000000000 : ℝ) = (458153619/640000000000 : ℝ) := by norm_num
      linarith [hA1, hA2, hQ1, hQ2, hAval, hBval])

/-- **BOX 103 CLOSED** -- unconditional top-edge negativity at t = 15
for sigma in [23/32, 3/4]. -/
theorem top15_box103_re_lt_neg_1e4 {σ : ℝ}
    (h0 : (23/32 : ℝ) ≤ σ) (h1 : σ ≤ 3/4) :
    (riemannXiEntire (⟨σ, 15⟩ : ℂ)).re < -(1/10000 : ℝ) :=
  lt_of_le_of_lt (box103_re_xi_le σ h0 h1) (by norm_num)

