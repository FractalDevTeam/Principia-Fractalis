/-- The `≠ 0` shape consumed by r328/r329b (`hTop`).  `Re z < 0` forces `z ≠ 0`. -/
theorem top15_re_lt_neg_1e4_ne_zero {σ : ℝ}
    (h0 : (1/2 : ℝ) ≤ σ) (h1 : σ ≤ 1) :
    riemannXiEntire (⟨σ, 15⟩ : ℂ) ≠ 0 := by
  intro hzero
  have hneg := top15_re_lt_neg_1e4 h0 h1
  have hre : (riemannXiEntire (⟨σ, 15⟩ : ℂ)).re = 0 := by rw [hzero]; simp
  linarith

/-- **H_TOP, DISCHARGED** -- exactly the hypothesis shape required by
`RiemannXiBottomEdgeUnconditional.boundary_zero_free_of_top_right_half`
and `.xi_T15_exact_zero_count_identity_top_only`. -/
theorem H_TOP_discharged :
    ∀ σ : ℝ, 1/2 ≤ σ → σ ≤ 1 → riemannXiEntire (⟨σ, 15⟩ : ℂ) ≠ 0 :=
  fun _ h0 h1 => top15_re_lt_neg_1e4_ne_zero h0 h1

