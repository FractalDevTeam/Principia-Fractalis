/-
# Riemann Sheet Monodromy of the Polylogarithm

The polylogarithm `Li_s(z)` has logarithmic monodromy around `z = 1`,
generated by the analytic continuation along loops winding around 1.
The m-th sheet polylog is defined by

  `Li_s^{[m]}(z) := Li_s(z) + 2πi · m · (log z)^(s-1) / Γ(s)`

For `m = 0` this is the principal-branch polylog (matching our `polyLog`).
For `m ≠ 0` it picks up the monodromy shift.

The book's `fractal_continuation_derivation.py` identifies the H_P-class
ground state eigenvalue via

  `λ_0(H_P) = π/(10√2) = Re[Li_{s*}^{[m*]}(e^{iπ√2})]`

with `s* ≈ 0.182, m* = −1`. The `m = −1` choice selects the non-principal
sheet whose real part matches the target eigenvalue.

This file establishes:
* `polyLogMonodromyShift m s z := 2πi · m · (log z)^(s-1) / Γ(s)`
* `polyLogSheet m s z := polyLog s z + polyLogMonodromyShift m s z`
* Basic properties: `m = 0` recovers `polyLog`, sheet arithmetic is additive
  in `m`, the shift vanishes at non-positive integer `s` (Γ pole).

Stage L4 — Riemann sheet monodromy foundation.
-/

import PF.Analytic.Polylog
import Mathlib.Analysis.SpecialFunctions.Gamma.Basic

namespace PrincipiaTractalis.Analytic

open Complex

/-! ## Definitions -/

/-- **The monodromy shift** at sheet `m`:
    `2πi · m · (log z)^(s−1) / Γ(s)`. This is the difference between the
    `m`-th sheet polylog and the principal-branch polylog. -/
noncomputable def polyLogMonodromyShift (m : ℤ) (s z : ℂ) : ℂ :=
  2 * (Real.pi : ℂ) * I * (m : ℂ) * (Complex.log z) ^ (s - 1) / Complex.Gamma s

/-- **The polylog on the m-th Riemann sheet**:
    `Li_s^{[m]}(z) := polyLog s z + 2πi · m · (log z)^(s−1) / Γ(s)`. -/
noncomputable def polyLogSheet (m : ℤ) (s z : ℂ) : ℂ :=
  polyLog s z + polyLogMonodromyShift m s z

/-! ## Basic identities -/

/-- **Principal sheet**: `polyLogSheet 0 s z = polyLog s z`. The `m = 0`
    monodromy shift vanishes (since `0 · ... = 0`). -/
theorem polyLogSheet_zero (s z : ℂ) :
    polyLogSheet 0 s z = polyLog s z := by
  unfold polyLogSheet polyLogMonodromyShift
  simp

/-- **Sheet difference**: `polyLogSheet m s z - polyLog s z` is the
    monodromy shift. -/
theorem polyLogSheet_sub_polyLog (m : ℤ) (s z : ℂ) :
    polyLogSheet m s z - polyLog s z = polyLogMonodromyShift m s z := by
  unfold polyLogSheet
  ring

/-- **Monodromy linearity in m**: the shift is linear in the sheet index. -/
theorem polyLogMonodromyShift_add (m n : ℤ) (s z : ℂ) :
    polyLogMonodromyShift (m + n) s z =
      polyLogMonodromyShift m s z + polyLogMonodromyShift n s z := by
  unfold polyLogMonodromyShift
  push_cast
  ring

/-- **Sheet additivity**: `polyLogSheet (m + n) = polyLogSheet m +
    polyLogMonodromyShift n`. Equivalently, advancing by `n` sheets adds
    `n` units of monodromy shift. -/
theorem polyLogSheet_add_sheet (m n : ℤ) (s z : ℂ) :
    polyLogSheet (m + n) s z =
      polyLogSheet m s z + polyLogMonodromyShift n s z := by
  unfold polyLogSheet
  rw [polyLogMonodromyShift_add]
  ring

/-- **Negative sheet identity**: `polyLogSheet (−1) s z = polyLog s z −
    2πi · (log z)^(s−1) / Γ(s)`. This is the book's specific case
    (`m* = −1` in `fractal_continuation_derivation.py`). -/
theorem polyLogSheet_neg_one (s z : ℂ) :
    polyLogSheet (-1) s z =
      polyLog s z -
        2 * (Real.pi : ℂ) * I * (Complex.log z) ^ (s - 1) / Complex.Gamma s := by
  unfold polyLogSheet polyLogMonodromyShift
  push_cast
  ring

/-! ## Vanishing of monodromy when Γ(s)⁻¹ = 0

The monodromy shift `polyLogMonodromyShift m s z = 2πi·m·(log z)^(s-1) / Γ(s)`
vanishes when `Γ(s)⁻¹ = 0`, i.e., when `Γ(s) = ∞` — but `Γ(s)` is never `∞`
in the standard `Complex.Gamma` (it returns 0 at non-positive integers
rather than ∞). So the shift formula treats `Γ(s) = 0` (at `s ∈ {0, -1, -2, …}`)
by giving division-by-zero in the literal expression. -/

/-- At `s ∈ {0, -1, -2, ...}`, `Γ(s) = 0` (mathlib convention), so the
    monodromy shift `polyLogMonodromyShift m s z = 2πi·m·(log z)^(s-1) / 0`
    equals 0 by Lean's `x / 0 = 0` convention. -/
theorem polyLogMonodromyShift_at_Gamma_zero
    (m : ℤ) {s : ℂ} (hs : Complex.Gamma s = 0) (z : ℂ) :
    polyLogMonodromyShift m s z = 0 := by
  unfold polyLogMonodromyShift
  rw [hs, div_zero]

/-- At `s ∈ {0, -1, -2, ...}`, all sheets collapse to the principal sheet
    (because the monodromy shift vanishes). -/
theorem polyLogSheet_eq_polyLog_of_Gamma_zero
    (m : ℤ) {s : ℂ} (hs : Complex.Gamma s = 0) (z : ℂ) :
    polyLogSheet m s z = polyLog s z := by
  unfold polyLogSheet
  rw [polyLogMonodromyShift_at_Gamma_zero m hs z, add_zero]

end PrincipiaTractalis.Analytic
