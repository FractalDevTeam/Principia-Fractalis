-/

import Mathlib.RingTheory.PiTensorProduct
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Tactic
import PF.TernaryNetIsotony_r352

namespace PrincipiaTractalis
namespace TernaryNetAdditivity

open PiTensorProduct TernaryLocalNet TernaryNetIsotony
open scoped TensorProduct

variable (ι : Type*) [DecidableEq ι]

/-! ## §1 — Additivity -/

/-- **★★★ Additivity.** The algebra of a union of two regions is the subalgebra
generated by the two pieces.

Two rewrites: the generating set splits over the union
(`Set.biUnion_union`), and `Algebra.adjoin` carries unions to suprema
(`Algebra.adjoin_union`, itself `GaloisConnection.l_sup`). -/
theorem additivity (S T : Set ι) :
    regionAlgebra ι (S ∪ T) = regionAlgebra ι S ⊔ regionAlgebra ι T := by
  unfold regionAlgebra
  rw [Set.biUnion_union, Algebra.adjoin_union]

/-- **Additivity for arbitrary families.** The same for any indexed union of
regions, via `Algebra.adjoin_iUnion` (`GaloisConnection.l_iSup`). -/
theorem additivity_iUnion {α : Type*} (S : α → Set ι) :
    regionAlgebra ι (⋃ k, S k) = ⨆ k, regionAlgebra ι (S k) := by
  unfold regionAlgebra
  rw [Set.biUnion_iUnion, Algebra.adjoin_iUnion]

/-- **The empty region carries the trivial algebra.** -/
@[simp]
theorem regionAlgebra_empty : regionAlgebra ι (∅ : Set ι) = ⊥ := by
  unfold regionAlgebra
  simp

/-! ## §2 — Capstone: the net's structural axioms, and what is missing -/

/-- **The ternary net satisfies isotony, locality and additivity.**

(1) isotony — `r352`
(2) locality — `r352`
(3) additivity, binary and indexed, and the empty region — here

**NOT included: `𝒜(ι) = ⊤`.** The net is not shown to exhaust the substrate;
that needs a `PiTensorProduct` spanning result and is a real lemma rather than
a rewrite. Covariance is likewise absent and blocked on `Aut(T_∞)`. See the
header. -/
theorem ternary_net_structural_axioms :
    -- isotony
    (∀ S T : Set ι, S ⊆ T → regionAlgebra ι S ≤ regionAlgebra ι T) ∧
    -- locality
    (∀ S T : Set ι, (∀ i ∈ S, ∀ j ∈ T, i ≠ j) →
      ∀ x y : SubstrateNet ι,
        x ∈ regionAlgebra ι S → y ∈ regionAlgebra ι T → Commute x y) ∧
    -- additivity
    (∀ S T : Set ι,
      regionAlgebra ι (S ∪ T) = regionAlgebra ι S ⊔ regionAlgebra ι T) ∧
    -- the empty region
    (regionAlgebra ι (∅ : Set ι) = ⊥) :=
  ⟨fun _ _ h => isotony ι h,
   fun _ _ hST _ _ hx hy => region_locality ι hST hx hy,
   additivity ι,
   regionAlgebra_empty ι⟩

end TernaryNetAdditivity
end PrincipiaTractalis

/-! ## §Axiom check -/

#print axioms PrincipiaTractalis.TernaryNetAdditivity.additivity
#print axioms PrincipiaTractalis.TernaryNetAdditivity.additivity_iUnion
#print axioms PrincipiaTractalis.TernaryNetAdditivity.regionAlgebra_empty
#print axioms PrincipiaTractalis.TernaryNetAdditivity.ternary_net_structural_axioms
