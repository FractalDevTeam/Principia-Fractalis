/-- **★ (I4) Φ axiom-free closed forms (6/9) bundle ★** — the
    Wave 55-PhiPSLQ per-α algebraic identities at the 7 non-YM,
    non-NP α-instances (Poincaré, RH, P, BSD, NS, Hodge, QG). -/
def PhiClosedFormsBundle : Prop :=
  -- Poincaré: 1 − 7α + 6α² = 0 at α = 1.
  (1 - 7 * MillenniumSix.alpha_value MillenniumSix.AlphaClass8.Poincare +
   6 * MillenniumSix.alpha_value MillenniumSix.AlphaClass8.Poincare ^ 2 = 0) ∧
  -- RH: 3α − 2α² = 0 at α = 3/2.
  (3 * MillenniumSix.alpha_value MillenniumSix.AlphaClass8.RH -
   2 * MillenniumSix.alpha_value MillenniumSix.AlphaClass8.RH ^ 2 = 0) ∧
  -- P: α² = 2 at α = √2.
  (MillenniumSix.alpha_value MillenniumSix.AlphaClass8.P ^ 2 = 2) ∧
  -- BSD: 3π − 4α = 0 at α = 3π/4.
  (3 * Real.pi -
   4 * MillenniumSix.alpha_value MillenniumSix.AlphaClass8.BSD = 0) ∧
  -- NS: 3π − 2α = 0 at α = 3π/2.
  (3 * Real.pi -
   2 * MillenniumSix.alpha_value MillenniumSix.AlphaClass8.NS = 0) ∧
  -- Hodge: 1 + α − α² = 0 at α = φ.
  (1 + MillenniumSix.alpha_value MillenniumSix.AlphaClass8.Hodge -
   MillenniumSix.alpha_value MillenniumSix.AlphaClass8.Hodge ^ 2 = 0) ∧
  -- QG: α² = 2π at α = √(2π).
  (alpha_QG ^ 2 = 2 * Real.pi)

