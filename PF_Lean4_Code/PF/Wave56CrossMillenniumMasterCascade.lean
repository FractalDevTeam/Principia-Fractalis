      PrincipiaTractalis.Consciousness.fractalResonance (k : ℝ) s =
      PrincipiaTractalis.Consciousness.fractalResonance 0 s) ∧
  -- Odd k: R_f(k, s) = R_f(1, s).
  (∀ (k : ℕ) (s : ℂ), Odd k →
      PrincipiaTractalis.Consciousness.fractalResonance (k : ℝ) s =
      PrincipiaTractalis.Consciousness.fractalResonance 1 s) ∧
  -- Combined: R_f(k, s) = if Even k then R_f(0, s) else R_f(1, s).
  (∀ (k : ℕ) (s : ℂ),
      PrincipiaTractalis.Consciousness.fractalResonance (k : ℝ) s =
      (if Even k then
        PrincipiaTractalis.Consciousness.fractalResonance 0 s
       else
        PrincipiaTractalis.Consciousness.fractalResonance 1 s))

/-- The R_f integer-α dichotomy bundle holds axiom-free. -/
