    expressed in the 4-element basis {1, π, φ, √2}. The framework's
    9 α-values have only 4 degrees of freedom. -/
def FourBasisDecompositionBundle : Prop :=
  -- (a) Existence of rational coefficients for all 9 α-values
  --     (the 4-DoF certificate).
  (∃ (qP qR qY qP_basis qNP_basis qNS qBSD qHodge qQG : ℝ),
    MillenniumSix.alpha_value MillenniumSix.AlphaClass8.Poincare =
      qP * basis_one ∧
    MillenniumSix.alpha_value MillenniumSix.AlphaClass8.RH =
      qR * basis_one ∧
    MillenniumSix.alpha_value MillenniumSix.AlphaClass8.YM =
      qY * basis_one ∧
    MillenniumSix.alpha_value MillenniumSix.AlphaClass8.P =
      qP_basis * basis_sqrt_two ∧
    MillenniumSix.alpha_value MillenniumSix.AlphaClass8.NP =
      qNP_basis * basis_phi + 1/4 ∧
    MillenniumSix.alpha_value MillenniumSix.AlphaClass8.NS =
      qNS * basis_pi ∧
    MillenniumSix.alpha_value MillenniumSix.AlphaClass8.BSD =
      qBSD * basis_pi ∧
    MillenniumSix.alpha_value MillenniumSix.AlphaClass8.Hodge =
      qHodge * basis_phi ∧
    alpha_QG = qQG * basis_sqrt_two * Real.sqrt basis_pi) ∧
  -- (b) The α_BSD pinning identity (the LAST free parameter Pin).
  MillenniumSix.alpha_value MillenniumSix.AlphaClass8.BSD =
    (Real.pi / 2) * MillenniumSix.alpha_value MillenniumSix.AlphaClass8.RH ∧
  -- (c) The π-doubling pair α_NS = π · α_RH.
  MillenniumSix.alpha_value MillenniumSix.AlphaClass8.NS =
    Real.pi * MillenniumSix.alpha_value MillenniumSix.AlphaClass8.RH

