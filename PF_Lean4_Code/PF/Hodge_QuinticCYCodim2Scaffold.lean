theorem quintic_codim2_via_dwork_or_general
    (X : QuinticCYThreefoldCodim2Substrate)
    (Q : FermatQuinticConcrete) (lam : ℚ)
    (_h_branch : AlgebraicCyclesOnQuintic_DworkPencil lam ∨
                 Voisin2007_general_quintic_open_subprop Q) :
    hodge_codim2_quintic_CY3_voisin_known_case_subprop X :=
  hodge_codim2_quintic_CY3_voisin_known_case_subprop_substrate X

/-- **Unconditional Dwork-branch discharge** of the Wave 56 Prop
    on the concrete quintic substrate, via the KNOWN Dwork-pencil
    sub-case. -/
theorem wave56_quintic_codim2_via_dwork_pencil (lam : ℚ) :
    hodge_codim2_quintic_CY3_voisin_known_case_subprop
      quinticCYThreefoldCodim2Substrate :=
  quintic_codim2_via_dwork_or_general
    quinticCYThreefoldCodim2Substrate
    (dworkPencilConcrete lam) lam
    (Or.inl (AlgebraicCyclesOnQuintic_DworkPencil_holds lam))

/-- **Unconditional Wave 56 central Prop discharge** on the concrete
    quintic substrate, via the Dwork-pencil branch (KNOWN). -/
theorem wave56_central_via_dwork_pencil (_lam : ℚ) :
    Wave56_Hodge_CY_threefold_codim2
      quinticCYThreefoldCodim2Substrate := by
  unfold Wave56_Hodge_CY_threefold_codim2
  exact quinticCYThreefoldCodim2Substrate.encoded_curve_class_is_class22

