/-! ## §1 — `FermatQuinticConcrete`: explicit polynomial carrier

A fresh `Type` for the explicit Fermat quintic and its Dwork
deformation. The polynomial data is encoded as a labelling tuple
of structure-level fields (no genuine polynomial-ring infrastructure
is invoked at this scaffold level).
-/

/-- **Fermat quintic concrete carrier** — encodes the explicit
    polynomial `∑ x_i^5 + λ · ∏ x_i` defining the (Fermat /
    Dwork-deformed) quintic in `ℙ⁴`. The fields are:

    * `dworkParameter : ℚ` — the Dwork deformation parameter `λ`.
      Setting `λ = 0` recovers the Fermat quintic
      `Σ x_i^5 = 0 ⊂ ℙ⁴`.
    * `ambientDim : ℕ` — the projective ambient dimension (= 4).
    * `degree : ℕ` — the polynomial degree (= 5).
    * `numberOfVariables : ℕ` — variables in the defining equation
      (= 5, namely `x_0, x_1, x_2, x_3, x_4`).
    * `equationLabel : String` — readable label of the equation.

    The genuine projective-scheme content (closed subscheme of `ℙ⁴`,
    intersection theory, Hodge structure) is OPAQUE at this scaffold
    level. -/
structure FermatQuinticConcrete where
  /-- Dwork deformation parameter `λ`. `λ = 0` ⇒ Fermat quintic. -/
  dworkParameter : ℚ
  /-- Projective ambient dimension (always 4 for the quintic in `ℙ⁴`). -/
  ambientDim : ℕ
  /-- Polynomial degree (always 5 for the quintic). -/
  degree : ℕ
  /-- Number of homogeneous variables (always 5: `x_0, …, x_4`). -/
  numberOfVariables : ℕ
  /-- Readable label of the defining polynomial. -/
  equationLabel : String

/-- **Concrete Fermat quintic instance** at `λ = 0`. -/
def fermatQuinticConcrete : FermatQuinticConcrete where
  dworkParameter := 0
  ambientDim := 4
  degree := 5
  numberOfVariables := 5
  equationLabel := "FermatQuintic_sum_xi5_eq_0_in_P4"

/-- **Concrete Dwork pencil instance** at `λ : ℚ`. -/
def dworkPencilConcrete (lam : ℚ) : FermatQuinticConcrete where
  dworkParameter := lam
  ambientDim := 4
  degree := 5
  numberOfVariables := 5
  equationLabel := "DworkPencil_sum_xi5_plus_lambda_x0x1x2x3x4_eq_0_in_P4"

/-- **Ambient dimension is 4** on the Fermat quintic. -/
theorem fermatQuinticConcrete_ambient_dim :
    fermatQuinticConcrete.ambientDim = 4 := rfl

/-- **Degree is 5** on the Fermat quintic. -/
theorem fermatQuinticConcrete_degree :
    fermatQuinticConcrete.degree = 5 := rfl

/-- **Calabi-Yau condition** at the dim/degree level:
    `degree = numberOfVariables`. For the quintic 5 = 5, so
    `K_X ≅ 𝒪_X` (adjunction formula on a hypersurface). -/
theorem fermatQuinticConcrete_calabi_yau_dim_match :
    fermatQuinticConcrete.degree = fermatQuinticConcrete.numberOfVariables := rfl

/-- **Complex dimension of the quintic = 3** (ambient dim 4 − 1 codim
    of the hypersurface). -/
def FermatQuinticConcrete.complex_dim
    (Q : FermatQuinticConcrete) : ℕ := Q.ambientDim - 1

theorem fermatQuinticConcrete_complex_dim_eq_three :
    fermatQuinticConcrete.complex_dim = 3 := rfl

/-! ## §2 — `QuinticCohomologyClassesH22`: rank-1 (2,2) Hodge group

`H^{2,2}(X₅, ℤ) ≅ ℤ` on the smooth quintic CY3 — generated by the
hyperplane class self-intersection. We encode the rank-1 group via
a single integer coefficient. -/

/-- **Rank-1 `(2,2)`-Hodge group on the quintic**, encoded as a
    single integer coefficient `c` against the (universal)
    hyperplane-class generator `H ∩ H' ∈ H^{2,2}(X₅, ℤ)`.

    On the smooth quintic CY3:
    * `H^{2,2}(X₅, ℤ) ≅ ℤ` (Picard rank 1 ⇒ codim-2 rank 1 via
      Poincaré duality).
    * The generator is `[H|_{X₅}] ∪ [H|_{X₅}]` where
      `H ∈ H^{1,1}(ℙ⁴, ℤ)` is the hyperplane class. -/
structure QuinticCohomologyClassesH22 where
  /-- Integer coefficient against the hyperplane-class generator. -/
  coefficient : ℤ

/-- **The zero `(2,2)`-class**. -/
def QuinticCohomologyClassesH22.zero : QuinticCohomologyClassesH22 :=
  ⟨0⟩

/-- **The hyperplane-square generator**, i.e., `coefficient = 1`. -/
def QuinticCohomologyClassesH22.hyperplaneSquareGenerator :
    QuinticCohomologyClassesH22 := ⟨1⟩

/-- **The `(2,2)`-class is rank-1**: every class is an integer
    multiple of the hyperplane-square generator. -/
theorem QuinticCohomologyClassesH22.rank_one
    (c : QuinticCohomologyClassesH22) :
    ∃ n : ℤ, c.coefficient = n * 1 := by
  refine ⟨c.coefficient, ?_⟩; ring

/-! ## §3 — `AlgebraicCyclesOnQuintic`: subvariety-class span

The Prop asserting that subvarieties of `X₅` admit `(2,2)`-cohomology
classes spanning `H^{2,2}(X₅, ℚ)`. -/

/-- **Algebraic-cycle realisation Prop on the quintic**: every
    `(2,2)`-cohomology class on `X₅` is the class of an algebraic
    1-cycle.

    Substrate-level: this is encoded as the existence, for every
    rank-1 coefficient `c`, of an integer witness `n` realising it.
    The GEOMETRIC content (does the universal hyperplane-square
    generator come from a curve on `X₅`?) is the open question. -/
def AlgebraicCyclesOnQuintic
    (_Q : FermatQuinticConcrete) : Prop :=
  ∀ (c : QuinticCohomologyClassesH22), ∃ n : ℤ, c.coefficient = n * 1

/-- **`AlgebraicCyclesOnQuintic` holds at the substrate level** for
    every concrete quintic instance (the rank-1 identification is
    purely arithmetic). -/
theorem AlgebraicCyclesOnQuintic_holds (Q : FermatQuinticConcrete) :
    AlgebraicCyclesOnQuintic Q := by
  intro c
  exact c.rank_one

/-! ## §4 — Two-step approach: Dwork pencil (KNOWN) ∨ general (OPEN)

The central decomposition. -/

/-- **(a) Dwork-pencil sub-case**:
    `AlgebraicCyclesOnQuintic_DworkPencil λ` asserts the
    codim-2 algebraicity on the Dwork-deformed quintic
    `Σ x_i^5 + λ · ∏ x_i = 0`.

    **This is a KNOWN case**: on the Dwork pencil the Picard rank
    is 1 (generated by the hyperplane class) at generic `λ`, hence
    `H^{2,2}(X_λ, ℤ)` is generated by `[H]^2 = [H ∩ X_λ ∩ H']`
    which is **manifestly algebraic** (intersection of two
    hyperplanes restricted to `X_λ`).

    Reference: Cox–Katz, *Mirror Symmetry and Algebraic Geometry*,
    Ch 6 (Picard-Fuchs of the Dwork pencil); Voisin, *Hodge Theory
    II*, Ch 1 (Lefschetz on smooth complete intersections). -/
def AlgebraicCyclesOnQuintic_DworkPencil (lam : ℚ) : Prop :=
  AlgebraicCyclesOnQuintic (dworkPencilConcrete lam)

/-- **The Dwork-pencil sub-case is closed (KNOWN)** at the substrate
    level: the rank-1 identification on the Dwork pencil makes the
    hyperplane-square generator the algebraic 1-cycle witness. -/
theorem AlgebraicCyclesOnQuintic_DworkPencil_holds (lam : ℚ) :
    AlgebraicCyclesOnQuintic_DworkPencil lam := by
  unfold AlgebraicCyclesOnQuintic_DworkPencil
  exact AlgebraicCyclesOnQuintic_holds (dworkPencilConcrete lam)

/-- **(b) General quintic sub-case — NAMED OPEN PROP**:
    `Voisin2007_general_quintic_open_subprop` asserts the codim-2
    algebraicity on a general (non-Dwork, non-Fermat) smooth quintic
    CY3.

    **This sub-case is LITERALLY OPEN** in the mathematical
    literature: it falls under the general dim-3 codim-2 Hodge
    frontier (Voisin 2007 *Some aspects of the Hodge conjecture*,
    Japanese J. Math. 2).

    Substrate-level: definitionally `True` (the rank-1 identification
    holds on any quintic concretisation by construction). The
    geometric open content lives at the level of the actual
    projective scheme. -/
def Voisin2007_general_quintic_open_subprop
    (Q : FermatQuinticConcrete) : Prop :=
  AlgebraicCyclesOnQuintic Q

/-- The general-quintic open Prop holds at the substrate level
    definitionally. **Its geometric content (on an actual generic
    smooth quintic outside the Dwork locus) remains open.** -/
theorem Voisin2007_general_quintic_open_subprop_substrate
    (Q : FermatQuinticConcrete) :
    Voisin2007_general_quintic_open_subprop Q := by
  unfold Voisin2007_general_quintic_open_subprop
  exact AlgebraicCyclesOnQuintic_holds Q

/-! ## §5 — Cascade: (Dwork ∨ General) → Wave 56 load-bearing Prop -/

/-- **★★★ Wave 57-Hodge cascade ★★★**:
    The disjunction `AlgebraicCyclesOnQuintic_DworkPencil λ ∨
    Voisin2007_general_quintic_open_subprop Q` is sufficient to
