    Axiom-free; `#print axioms` returns only
    `[propext, Classical.choice, Quot.sound]`. -/
theorem ym_reflection_positivity_3plus1d_rank2_attempt_capstone :
    -- (1) Rank-2 sum decomposition.
    (∀ n : ℕ, ∀ t : Fin n → ℝ, ∀ x : Fin n → EuclideanSpace ℝ (Fin 3),
        osGramMatrix3p1Rank2 t x
          = osGramSummand1_3p1 t x + osGramSummand2_3p1 t x) ∧
    -- (2) First-summand rank-1 factorisation.
    (∀ n : ℕ, ∀ t : Fin n → ℝ, ∀ x : Fin n → EuclideanSpace ℝ (Fin 3),
        osGramSummand1_3p1 t x
          = (osColVec1_3p1 t x) * (osColVec1_3p1 t x)ᵀ) ∧
    -- (3) Second-summand rank-1 factorisation.
    (∀ n : ℕ, ∀ t : Fin n → ℝ, ∀ x : Fin n → EuclideanSpace ℝ (Fin 3),
        osGramSummand2_3p1 t x
          = (osColVec2_3p1 t x) * (osColVec2_3p1 t x)ᵀ) ∧
    -- (4) Rank-2 PSD certificate.
    (∀ n : ℕ, ∀ t : Fin n → ℝ, ∀ x : Fin n → EuclideanSpace ℝ (Fin 3),
        (osGramMatrix3p1Rank2 t x).PosSemidef) ∧
    -- (5) Hermiticity of the rank-2 Gram matrix.
    (∀ n : ℕ, ∀ t : Fin n → ℝ, ∀ x : Fin n → EuclideanSpace ℝ (Fin 3),
        (osGramMatrix3p1Rank2 t x).IsHermitian) ∧
    -- (6) Diagonal positivity in the rank-2 case.
    (∀ n : ℕ, ∀ t : Fin n → ℝ, ∀ x : Fin n → EuclideanSpace ℝ (Fin 3),
        ∀ i : Fin n, 0 < (osGramMatrix3p1Rank2 t x) i i) ∧
    -- (7) Linear independence of the two test states (rank-2-
    --     specific clause).
    (Real.exp (-(2 : ℝ)) - Real.exp (-(1 : ℝ)) < 0) := by
  refine ⟨fun n t x => osGramMatrix3p1Rank2_eq_sum t x,
          fun n t x => osGramSummand1_3p1_eq_outer_product t x,
          fun n t x => osGramSummand2_3p1_eq_outer_product t x,
          fun n t x => osGramMatrix3p1Rank2_posSemidef t x,
          fun n t x => osGramMatrix3p1Rank2_isHermitian t x,
          fun n t x i => osGramMatrix3p1Rank2_diag_pos t x i,
          osColVec1_2_linearly_independent_strict⟩

