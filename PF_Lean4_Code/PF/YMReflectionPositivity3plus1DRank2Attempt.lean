import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.LinearAlgebra.Matrix.PosDef
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.Data.Real.StarOrdered
import Mathlib.Tactic

namespace PrincipiaTractalis
namespace YMReflectionPositivity3plus1DRank2Attempt

open Real
open scoped Matrix

/-! ## §1 — Two linearly-independent test-state column vectors

Wave 50D used a single column vector `v i := e^{-(t i)}`. We introduce
TWO column vectors `v₁, v₂` with different decay rates, ensuring
linear independence as functions of `t`. -/

/-- **First test-state column vector** in 3+1D:
    `osColVec1_3p1 t x i 0 := e^{-(t i)}`. Identical to Wave 50D's
    `osColVec3p1`; re-introduced under a `1`-indexed name to make the
    rank-2 sum explicit. -/
noncomputable def osColVec1_3p1 {n : ℕ} (t : Fin n → ℝ)
    (_x : Fin n → EuclideanSpace ℝ (Fin 3)) : Matrix (Fin n) (Fin 1) ℝ :=
  fun i _ => Real.exp (-(t i))

/-- **Second test-state column vector** in 3+1D:
    `osColVec2_3p1 t x i 0 := e^{-2 (t i)}`. Faster-decay second mode,
    linearly independent from `osColVec1_3p1` as a function of `t`. -/
noncomputable def osColVec2_3p1 {n : ℕ} (t : Fin n → ℝ)
    (_x : Fin n → EuclideanSpace ℝ (Fin 3)) : Matrix (Fin n) (Fin 1) ℝ :=
  fun i _ => Real.exp (-(2 * t i))

/-! ## §2 — Rank-2 OS Gram matrix and its summand decomposition

The rank-2 OS Gram matrix is the entrywise sum
`M₂_ij := e^{-(t i + t j)} + e^{-2 (t i + t j)}`. We exhibit it as
the sum of two rank-1 outer products. -/

/-- **Rank-2 OS Gram matrix** in 3+1D:
    `M₂_ij := e^{-(t i + t j)} + e^{-2 (t i + t j)}`. The simplest
    rank-2 PSD substrate matching two linearly-independent test
    states in the Clay-grade dimensionality. -/
noncomputable def osGramMatrix3p1Rank2 {n : ℕ} (t : Fin n → ℝ)
    (_x : Fin n → EuclideanSpace ℝ (Fin 3)) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => Real.exp (-(t i + t j)) + Real.exp (-(2 * (t i + t j)))

/-- **First-mode rank-1 summand**: the `v₁ · v₁ᵀ` outer product. -/
noncomputable def osGramSummand1_3p1 {n : ℕ} (t : Fin n → ℝ)
    (_x : Fin n → EuclideanSpace ℝ (Fin 3)) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => Real.exp (-(t i + t j))

/-- **Second-mode rank-1 summand**: the `v₂ · v₂ᵀ` outer product. -/
noncomputable def osGramSummand2_3p1 {n : ℕ} (t : Fin n → ℝ)
    (_x : Fin n → EuclideanSpace ℝ (Fin 3)) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => Real.exp (-(2 * (t i + t j)))

/-- **First-mode rank-1 factorisation**:
    `osGramSummand1_3p1 t x = v₁ · v₁ᵀ`. Direct port of Wave 50D's
    `osGramMatrix3p1_eq_outer_product`. -/
theorem osGramSummand1_3p1_eq_outer_product {n : ℕ} (t : Fin n → ℝ)
    (x : Fin n → EuclideanSpace ℝ (Fin 3)) :
    osGramSummand1_3p1 t x = (osColVec1_3p1 t x) * (osColVec1_3p1 t x)ᵀ := by
  funext i j
  unfold osGramSummand1_3p1 osColVec1_3p1
  rw [show (-(t i + t j) : ℝ) = (-(t i)) + (-(t j)) by ring, Real.exp_add]
  simp [Matrix.mul_apply, Matrix.transpose_apply]

/-- **Second-mode rank-1 factorisation**:
    `osGramSummand2_3p1 t x = v₂ · v₂ᵀ`. -/
theorem osGramSummand2_3p1_eq_outer_product {n : ℕ} (t : Fin n → ℝ)
    (x : Fin n → EuclideanSpace ℝ (Fin 3)) :
    osGramSummand2_3p1 t x = (osColVec2_3p1 t x) * (osColVec2_3p1 t x)ᵀ := by
  funext i j
  unfold osGramSummand2_3p1 osColVec2_3p1
  rw [show (-(2 * (t i + t j)) : ℝ) = (-(2 * t i)) + (-(2 * t j)) by ring,
      Real.exp_add]
  simp [Matrix.mul_apply, Matrix.transpose_apply]

/-- **Rank-2 sum decomposition**:
    `osGramMatrix3p1Rank2 t x = osGramSummand1_3p1 t x +
                                 osGramSummand2_3p1 t x`. -/
theorem osGramMatrix3p1Rank2_eq_sum {n : ℕ} (t : Fin n → ℝ)
    (x : Fin n → EuclideanSpace ℝ (Fin 3)) :
    osGramMatrix3p1Rank2 t x
      = osGramSummand1_3p1 t x + osGramSummand2_3p1 t x := by
  funext i j
  unfold osGramMatrix3p1Rank2 osGramSummand1_3p1 osGramSummand2_3p1
  simp [Matrix.add_apply]

/-! ## §3 — PSD certificates for each rank-1 summand -/

/-- **First summand is PSD**, via `posSemidef_self_mul_conjTranspose`
    applied to `osColVec1_3p1 t x`. -/
theorem osGramSummand1_3p1_posSemidef {n : ℕ} (t : Fin n → ℝ)
    (x : Fin n → EuclideanSpace ℝ (Fin 3)) :
    (osGramSummand1_3p1 t x).PosSemidef := by
  rw [osGramSummand1_3p1_eq_outer_product]
  have h : (osColVec1_3p1 t x)ᵀ = (osColVec1_3p1 t x)ᴴ := by
    funext i j
    simp [Matrix.transpose_apply, Matrix.conjTranspose_apply, osColVec1_3p1]
  rw [h]
  exact Matrix.posSemidef_self_mul_conjTranspose _

/-- **Second summand is PSD**, via `posSemidef_self_mul_conjTranspose`
    applied to `osColVec2_3p1 t x`. -/
theorem osGramSummand2_3p1_posSemidef {n : ℕ} (t : Fin n → ℝ)
    (x : Fin n → EuclideanSpace ℝ (Fin 3)) :
    (osGramSummand2_3p1 t x).PosSemidef := by
  rw [osGramSummand2_3p1_eq_outer_product]
  have h : (osColVec2_3p1 t x)ᵀ = (osColVec2_3p1 t x)ᴴ := by
    funext i j
    simp [Matrix.transpose_apply, Matrix.conjTranspose_apply, osColVec2_3p1]
  rw [h]
  exact Matrix.posSemidef_self_mul_conjTranspose _

/-! ## §4 — Rank-2 PSD via `Matrix.PosSemidef.add` -/

/-- **★ 3+1D RANK-2 TOY OS POSITIVITY ★** (axiom-free, via
    `Matrix.PosSemidef.add`): the rank-2 OS Gram matrix is PSD for
    ANY spacetime parameters
    `(t, x) : (Fin n → ℝ) × (Fin n → EuclideanSpace ℝ (Fin 3))`.

    Proof strategy: factor `M₂ = v₁ · v₁ᵀ + v₂ · v₂ᵀ`; each rank-1
    factor is PSD via `posSemidef_self_mul_conjTranspose`; their
    sum is PSD via `Matrix.PosSemidef.add`.

    Strictly stronger than Wave 50D's rank-1 result: the certificate
    covers a 2-dim test-state span instead of a 1-dim span — the
    finite-dim signature of multi-particle OS-RP. -/
theorem osGramMatrix3p1Rank2_posSemidef {n : ℕ} (t : Fin n → ℝ)
    (x : Fin n → EuclideanSpace ℝ (Fin 3)) :
    (osGramMatrix3p1Rank2 t x).PosSemidef := by
  rw [osGramMatrix3p1Rank2_eq_sum]
  exact (osGramSummand1_3p1_posSemidef t x).add
        (osGramSummand2_3p1_posSemidef t x)

/-! ## §5 — Discrete rank-2 OS-positivity statement -/

/-- **Discrete 3+1D rank-2 OS reflection-positivity statement**: for
    any `n`, any time parameters `t : Fin n → ℝ`, and any spatial
    parameters `x : Fin n → EuclideanSpace ℝ (Fin 3)`, the quadratic
    form `yᵀ M₂ y ≥ 0` for all `y : Fin n → ℝ`. -/
theorem discrete_OS_reflection_positivity_3p1_rank2_toy {n : ℕ}
    (t : Fin n → ℝ) (x : Fin n → EuclideanSpace ℝ (Fin 3))
    (y : Fin n → ℝ) :
    0 ≤ (star y) ⬝ᵥ ((osGramMatrix3p1Rank2 t x) *ᵥ y) :=
  (osGramMatrix3p1Rank2_posSemidef t x).2 y

/-- **Hermiticity (= symmetry on ℝ) of the rank-2 3+1D toy OS Gram
    matrix**: `M₂ = M₂ᵀ`. -/
theorem osGramMatrix3p1Rank2_isHermitian {n : ℕ} (t : Fin n → ℝ)
    (x : Fin n → EuclideanSpace ℝ (Fin 3)) :
    (osGramMatrix3p1Rank2 t x).IsHermitian :=
  (osGramMatrix3p1Rank2_posSemidef t x).1

/-! ## §6 — Diagonal-entry positivity -/

/-- **Diagonal entries strictly positive in the rank-2 case**:
    `M₂ ii = e^{-2 t_i} + e^{-4 t_i} > 0`, independent of `x i`. -/
theorem osGramMatrix3p1Rank2_diag_pos {n : ℕ} (t : Fin n → ℝ)
    (x : Fin n → EuclideanSpace ℝ (Fin 3)) (i : Fin n) :
    0 < (osGramMatrix3p1Rank2 t x) i i := by
  unfold osGramMatrix3p1Rank2
  exact add_pos (Real.exp_pos _) (Real.exp_pos _)

/-- **Diagonal entries closed form in the rank-2 case**:
    `M₂ ii = e^{-(2 t i)} + e^{-(4 t i)}`. -/
theorem osGramMatrix3p1Rank2_diag_eq {n : ℕ} (t : Fin n → ℝ)
    (x : Fin n → EuclideanSpace ℝ (Fin 3)) (i : Fin n) :
    (osGramMatrix3p1Rank2 t x) i i
      = Real.exp (-(2 * t i)) + Real.exp (-(4 * t i)) := by
  unfold osGramMatrix3p1Rank2
  ring_nf

/-! ## §7 — Linear-independence of the two test states (numerical check)

We exhibit a concrete pair of time parameters where `v₁` and `v₂`
take distinct, non-proportional values, witnessing that the two
columns span a genuine 2-dim subspace of `Matrix (Fin n) (Fin 1) ℝ`. -/

/-- **Numerical linear-independence witness**: at `t = (0, 1)`, the
    two test states have values `v₁ = (1, e^{-1})` and
    `v₂ = (1, e^{-2})`. The 2×2 matrix `[v₁ | v₂]` has determinant
    `e^{-2} - e^{-1} ≠ 0`, confirming linear independence. -/
theorem osColVec1_2_linearly_independent_witness :
    (osColVec1_3p1 (fun (i : Fin 2) => (i.val : ℝ))
                   (fun _ => (0 : EuclideanSpace ℝ (Fin 3))) 0 0) *
    (osColVec2_3p1 (fun (i : Fin 2) => (i.val : ℝ))
                   (fun _ => (0 : EuclideanSpace ℝ (Fin 3))) 1 0)
    -
    (osColVec1_3p1 (fun (i : Fin 2) => (i.val : ℝ))
                   (fun _ => (0 : EuclideanSpace ℝ (Fin 3))) 1 0) *
    (osColVec2_3p1 (fun (i : Fin 2) => (i.val : ℝ))
                   (fun _ => (0 : EuclideanSpace ℝ (Fin 3))) 0 0)
    = Real.exp (-(2 * (1 : ℝ))) - Real.exp (-(1 : ℝ)) *
      Real.exp (-(2 * (0 : ℝ))) := by
  unfold osColVec1_3p1 osColVec2_3p1
  simp

/-- **Strict non-vanishing of the rank-2 Wronskian-like quantity**:
    `e^{-2} - e^{-1} < 0`, i.e. the determinant of the test-state
    matrix at `t = (0, 1)` is non-zero. Hence the two test-states
    `v₁, v₂` are LINEARLY INDEPENDENT as functions of `t`. -/
theorem osColVec1_2_linearly_independent_strict :
    Real.exp (-(2 : ℝ)) - Real.exp (-(1 : ℝ)) < 0 := by
  have h1 : Real.exp (-(2 : ℝ)) < Real.exp (-(1 : ℝ)) := by
    apply Real.exp_lt_exp.mpr
    norm_num
  linarith

/-! ## §8 — Capstone -/

/-- ★★★ **CAPSTONE: 3+1D RANK-2 toy OS reflection-positivity** ★★★
    (Wave 51D extension, 2026-05-31)

    Direct extension of Wave 50D's rank-1 3+1D OS Gram-matrix
