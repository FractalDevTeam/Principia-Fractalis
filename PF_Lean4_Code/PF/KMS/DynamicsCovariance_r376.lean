import PF.KMS.NetCovariance_r375

set_option autoImplicit false

namespace PF.KMS

open PiTensorProduct
open PrincipiaTractalis.TernaryLocalNet

variable {ι : Type*} [DecidableEq ι]

/-! ## §1 — Conjugation on the net, with an explicit inverse pair -/

/-- Conjugation of `u` by the pair `(w, w')`. When `w * w' = 1` this is the
modular automorphism of the weight `w` on the net. -/
noncomputable def netConj (w w' u : SubstrateNet ι) : SubstrateNet ι := w * u * w'

/-! ## §2 — Any algebra equivalence of the net carries the dynamics -/

/-- The conjugation transports along any algebra equivalence. -/
theorem algEquiv_conj (φ : SubstrateNet ι ≃ₐ[ℂ] SubstrateNet ι)
    (w w' u : SubstrateNet ι) :
    φ (netConj w w' u) = netConj (φ w) (φ w') (φ u) := by
  simp only [netConj, map_mul]

/-- **The half that carries the content**: the transported weight is still
invertible, with the transported inverse. So the right-hand side of
`algEquiv_conj` really is a conjugation. -/
theorem algEquiv_preserves_inverse (φ : SubstrateNet ι ≃ₐ[ℂ] SubstrateNet ι)
    {w w' : SubstrateNet ι} (h : w * w' = 1) : (φ w) * (φ w') = 1 := by
  rw [← map_mul, h, map_one]

/-! ## §3 — The site-permutation instances: r375's item 4 -/

/-- **★★★ r376: the dynamics is covariant for the site-permutation action ★★★**

`α_g (σ_w u) = σ_{α_g w} (α_g u)`. -/
theorem sitePermAlgEquiv_conj (e : ι ≃ ι) (w w' u : SubstrateNet ι) :
    sitePermAlgEquiv e (netConj w w' u)
      = netConj (sitePermAlgEquiv e w) (sitePermAlgEquiv e w')
          (sitePermAlgEquiv e u) :=
  algEquiv_conj (sitePermAlgEquiv e) w w' u

/-- And the transported weight is still a weight. -/
theorem sitePermAlgEquiv_preserves_inverse (e : ι ≃ ι)
    {w w' : SubstrateNet ι} (h : w * w' = 1) :
    (sitePermAlgEquiv e w) * (sitePermAlgEquiv e w') = 1 :=
  algEquiv_preserves_inverse (sitePermAlgEquiv e) h

/-- The two halves bundled: the site-permutation symmetry carries the dynamics
generated by `w` to the dynamics generated by `α_g w`. This is covariance of
the dynamics, and closes the fourth item r375 listed as unclaimed. -/
theorem sitePermAlgEquiv_dynamics_covariant (e : ι ≃ ι)
    {w w' : SubstrateNet ι} (h : w * w' = 1) (u : SubstrateNet ι) :
    sitePermAlgEquiv e (netConj w w' u)
        = netConj (sitePermAlgEquiv e w) (sitePermAlgEquiv e w')
            (sitePermAlgEquiv e u)
      ∧ (sitePermAlgEquiv e w) * (sitePermAlgEquiv e w') = 1 :=
  ⟨sitePermAlgEquiv_conj e w w' u, sitePermAlgEquiv_preserves_inverse e h⟩

/-- The action is covariant *as a group action*: composing two permutations
composes the transported dynamics, by r375's `_trans`. -/
theorem sitePermAlgEquiv_conj_trans (e₁ e₂ : ι ≃ ι) (w w' u : SubstrateNet ι) :
    sitePermAlgEquiv (e₁.trans e₂) (netConj w w' u)
      = netConj (sitePermAlgEquiv e₂ (sitePermAlgEquiv e₁ w))
          (sitePermAlgEquiv e₂ (sitePermAlgEquiv e₁ w'))
          (sitePermAlgEquiv e₂ (sitePermAlgEquiv e₁ u)) := by
  -- push the conjugation through each factor of the composite in turn
  rw [sitePermAlgEquiv_trans, sitePermAlgEquiv_conj, sitePermAlgEquiv_conj]

end PF.KMS

/-! ## §Axiom check -/
#print axioms PF.KMS.algEquiv_conj
#print axioms PF.KMS.algEquiv_preserves_inverse
#print axioms PF.KMS.sitePermAlgEquiv_conj
#print axioms PF.KMS.sitePermAlgEquiv_preserves_inverse
#print axioms PF.KMS.sitePermAlgEquiv_dynamics_covariant
#print axioms PF.KMS.sitePermAlgEquiv_conj_trans
