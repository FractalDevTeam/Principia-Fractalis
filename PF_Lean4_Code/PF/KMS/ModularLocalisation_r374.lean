-/
import PF.KMS.NetModularAutomorphism_r373
import PF.KMS.ProductTypeFamily_r370
import PF.TernaryNetIsotony_r352

set_option autoImplicit false

namespace PF.KMS

open Matrix
open PrincipiaTractalis.TernaryLocalNet
open PrincipiaTractalis.TernaryNetIsotony
open PrincipiaTractalis.TernaryNetMatrixBridge
open PrincipiaTractalis.TernaryNetMatrixAlgBridge

/-! ## §1 — Conjugation by a commuting weight is trivial -/

/-- If `X` commutes with `a` then `σ_X` fixes `a`. The converse of r370's
`modularAut_ne_id_of_not_commute`. -/
theorem modularAut_eq_id_of_commute {n : ℕ} {X a : Matrix (Fin n) (Fin n) ℂ}
    (hX : IsUnit X.det) (h : Commute X a) : modularAut X a = a := by
  simp only [modularAut]
  rw [h.eq, mul_assoc, Matrix.mul_nonsing_inv X hX, mul_one]

/-- **★★★ r374: the modular automorphism fixes exactly the centraliser ★★★**

Together with r370's direction this is a characterisation, and it explains
r369's collapse: scalar weights are central, so the centraliser is everything
and the automorphism is the identity. -/
theorem modularAut_eq_id_iff_commute {n : ℕ} {X a : Matrix (Fin n) (Fin n) ℂ}
    (hX : IsUnit X.det) : modularAut X a = a ↔ Commute X a := by
  refine ⟨fun h => ?_, modularAut_eq_id_of_commute hX⟩
  by_contra hc
  exact modularAut_ne_id_of_not_commute hX (fun hcomm => hc hcomm) h

/-! ## §2 — Commutation transports across the net/level equivalence -/

lemma commute_netAlgEquivLevel (k : ℕ) {w u : Net k} (h : Commute w u) :
    Commute (netAlgEquivLevel k w) (netAlgEquivLevel k u) := by
  show (netAlgEquivLevel k w) * (netAlgEquivLevel k u)
      = (netAlgEquivLevel k u) * (netAlgEquivLevel k w)
  rw [← map_mul, ← map_mul, h.eq]

/-! ## §3 — The localisation statement -/

/-- **★★★ r374: the dynamics of a region-localised weight fixes disjoint
regions ★★★**

If `w ∈ 𝒜(S)` and `u ∈ 𝒜(T)` with `S` and `T` disjoint, the modular
automorphism of `w` leaves `u` alone. The dynamics cannot reach across
disjoint regions. -/
theorem netModularAut_eq_id_of_disjoint (k : ℕ) {S T : Set (Fin k)}
    (hST : ∀ i ∈ S, ∀ j ∈ T, i ≠ j) {w u : Net k}
    (hw : w ∈ regionAlgebra (Fin k) S) (hu : u ∈ regionAlgebra (Fin k) T)
    (hX : IsUnit (netAlgEquivLevel k w).det) :
    netModularAut k (netAlgEquivLevel k w) u = u := by
  have hcomm : Commute (netAlgEquivLevel k w) (netAlgEquivLevel k u) :=
    commute_netAlgEquivLevel k (region_locality (Fin k) hST hw hu)
  simp only [netModularAut, modularAut_eq_id_of_commute hX hcomm,
    AlgEquiv.symm_apply_apply]

/-- The same conclusion stated through the net's own functional: the Gibbs
functional of a weight in `𝒜(S)` cannot distinguish the order of a product
with anything in a disjoint `𝒜(T)`. -/
theorem netGibbs_tracial_on_disjoint (k : ℕ) {S T : Set (Fin k)}
    (hST : ∀ i ∈ S, ∀ j ∈ T, i ≠ j) {w u : Net k}
    (hw : w ∈ regionAlgebra (Fin k) S) (hu : u ∈ regionAlgebra (Fin k) T)
    (hX : IsUnit (netAlgEquivLevel k w).det) (v : Net k) :
    netGibbsFunctional k (netAlgEquivLevel k w) (u * v)
      = netGibbsFunctional k (netAlgEquivLevel k w) (v * u) := by
  have h := netGibbs_kms (netAlgEquivLevel k w) hX u v
  rwa [netModularAut_eq_id_of_disjoint k hST hw hu hX] at h

end PF.KMS

