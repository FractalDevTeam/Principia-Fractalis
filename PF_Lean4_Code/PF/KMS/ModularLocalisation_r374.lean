#print axioms PF.KMS.modularAut_eq_id_iff_commute
#print axioms PF.KMS.commute_netAlgEquivLevel
#print axioms PF.KMS.netModularAut_eq_id_of_disjoint
#print axioms PF.KMS.netGibbs_tracial_on_disjoint
