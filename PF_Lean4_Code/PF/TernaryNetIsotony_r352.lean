import Mathlib.RingTheory.PiTensorProduct
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Data.Matrix.Basic
import Mathlib.Tactic
import PF.TernaryLocalNet_r351

namespace PrincipiaTractalis
namespace TernaryNetIsotony

open PiTensorProduct TernaryLocalNet
open scoped TensorProduct

variable (ι : Type*) [DecidableEq ι]

/-! ## §1 — The algebra of a region -/

/-- **The local algebra of a region `S ⊆ ι`**: the subalgebra of the substrate
generated by the observables at the sites of `S`.

Generated inside the single ambient algebra `⨂[ℂ] (_ : ι), M₃`, so every
region's algebra is a subalgebra of the same object — which is what makes this
a net rather than a family of unrelated algebras. -/
noncomputable def regionAlgebra (S : Set ι) : Subalgebra ℂ (SubstrateNet ι) :=
  Algebra.adjoin ℂ (⋃ i ∈ S, Set.range (localAt ι i))

/-! ## §2 — Isotony -/

/-- **★★★ Isotony.** A larger region has a larger algebra.

One line: the generating set is monotone in the region, and `adjoin` is
monotone in its generating set. This is the payoff of generating inside a
fixed ambient algebra. -/
theorem isotony {S T : Set ι} (h : S ⊆ T) :
    regionAlgebra ι S ≤ regionAlgebra ι T :=
  Algebra.adjoin_mono (Set.biUnion_subset_biUnion_left h)

/-- **The region assignment extends the site assignment.** The algebra of a
single-site region is exactly that site's local algebra, so `r351`'s
`localAt` is recovered as the `S = {i}` case. -/
theorem regionAlgebra_singleton (i : ι) :
    regionAlgebra ι {i} = (localAt ι i).range := by
  unfold regionAlgebra
  rw [Set.biUnion_singleton]
  rw [show Set.range (localAt ι i) = ((localAt ι i).range : Set (SubstrateNet ι)) from rfl]
  exact Algebra.adjoin_eq _

/-! ## §3 — Locality over regions -/

/-- Every generator of `𝒜(S)` commutes with a fixed observable at a site
outside `S`; hence `𝒜(S)` lies in that observable's centralizer.

This is step 1 of the extension from generators to generated algebras. The
centralizer is a subalgebra, so `adjoin_le` carries the generator-level fact to
all of `𝒜(S)` with no induction over words. -/
theorem regionAlgebra_le_centralizer_single {S : Set ι} {j : ι}
    (hj : ∀ i ∈ S, i ≠ j) (b : Site) :
    regionAlgebra ι S ≤
      Subalgebra.centralizer ℂ {(localAt ι j b : SubstrateNet ι)} := by
  apply Algebra.adjoin_le
  intro z hz
  simp only [Set.mem_iUnion, Set.mem_range] at hz
  obtain ⟨i, hi, a, rfl⟩ := hz
  -- `mem_centralizer_iff` is `Iff.rfl`, so `rw` has no pattern to match;
  -- `.mpr` supplies the membership directly.
  refine (Subalgebra.mem_centralizer_iff (R := ℂ)).mpr ?_
  intro g hg
  rw [Set.mem_singleton_iff] at hg
  subst hg
  exact (local_commute ι (hj i hi) a b).symm.eq

/-- **★★★ Locality over regions.**

Disjoint regions have commuting algebras: everything in `𝒜(S)` commutes with
everything in `𝒜(T)`.

Step 2 of the extension: by the previous lemma each generator of `𝒜(T)` lies in
the centralizer of `𝒜(S)`, and that centralizer is a subalgebra, so `adjoin_le`
gives `𝒜(T) ≤ centralizer 𝒜(S)`. -/
theorem region_locality {S T : Set ι} (hST : ∀ i ∈ S, ∀ j ∈ T, i ≠ j)
    {x y : SubstrateNet ι}
    (hx : x ∈ regionAlgebra ι S) (hy : y ∈ regionAlgebra ι T) :
    Commute x y := by
  have step2 : regionAlgebra ι T ≤
      Subalgebra.centralizer ℂ ((regionAlgebra ι S : Set (SubstrateNet ι))) := by
    apply Algebra.adjoin_le
    intro z hz
    simp only [Set.mem_iUnion, Set.mem_range] at hz
    obtain ⟨j, hj, b, rfl⟩ := hz
    refine (Subalgebra.mem_centralizer_iff (R := ℂ)).mpr ?_
    intro g hg
    have hgc := regionAlgebra_le_centralizer_single ι
      (fun i hi => hST i hi j hj) b hg
    exact ((Subalgebra.mem_centralizer_iff (R := ℂ)).mp hgc _ rfl).symm
  exact (Subalgebra.mem_centralizer_iff (R := ℂ)).mp (step2 hy) x hx

/-! ## §4 — Capstone -/

/-- **The ternary net satisfies isotony and locality over arbitrary regions.**

(1) isotony: `S ⊆ T ⟹ 𝒜(S) ≤ 𝒜(T)`.
(2) the single-site region recovers `r351`'s local algebra.
(3) locality: pointwise-disjoint regions have commuting algebras.

Covariance and additivity are not here; see the header's "Not claimed". -/
theorem ternary_net_isotony_and_locality :
    (∀ S T : Set ι, S ⊆ T → regionAlgebra ι S ≤ regionAlgebra ι T) ∧
    (∀ i : ι, regionAlgebra ι {i} = (localAt ι i).range) ∧
    (∀ S T : Set ι, (∀ i ∈ S, ∀ j ∈ T, i ≠ j) →
      ∀ x y : SubstrateNet ι,
        x ∈ regionAlgebra ι S → y ∈ regionAlgebra ι T → Commute x y) :=
  ⟨fun _ _ h => isotony ι h,
   fun i => regionAlgebra_singleton ι i,
   fun _ _ hST _ _ hx hy => region_locality ι hST hx hy⟩

end TernaryNetIsotony
end PrincipiaTractalis

/-! ## §Axiom check -/

#print axioms PrincipiaTractalis.TernaryNetIsotony.isotony
#print axioms PrincipiaTractalis.TernaryNetIsotony.regionAlgebra_singleton
#print axioms PrincipiaTractalis.TernaryNetIsotony.regionAlgebra_le_centralizer_single
#print axioms PrincipiaTractalis.TernaryNetIsotony.region_locality
#print axioms PrincipiaTractalis.TernaryNetIsotony.ternary_net_isotony_and_locality
