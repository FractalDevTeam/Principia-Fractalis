def SprCertA₁ (B₄ B₆ B₈ : ℤ) : ℤ :=
  |B₆| + |B₄^2 + B₈| + |B₄*B₆| + |4*B₄*B₆| + |B₄*B₈ + 3*B₆^2| + |2*B₄*B₈ + 4*B₆^2| + |5*B₆*B₈| + |4*B₆*B₈| + |2*B₈^2| + |B₈^2|

theorem SprCertA₁_nonneg (B₄ B₆ B₈ : ℤ) : 0 ≤ SprCertA₁ B₄ B₆ B₈ := by
  rw [SprCertA₁]
  repeat' apply add_nonneg
  all_goals exact abs_nonneg _

theorem abs_prCertA₁_le (B₄ B₆ B₈ a₁ b₁ a₂ b₂ : ℤ) :
    |prCertA₁ B₄ B₆ B₈ a₁ b₁ a₂ b₂|
      ≤ SprCertA₁ B₄ B₆ B₈ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|) := by
  have hM : (0:ℤ) ≤ max |a₁| |b₁| := le_trans (abs_nonneg a₁) (le_max_left _ _)
  have hH : (0:ℤ) ≤ max |a₂| |b₂| := le_trans (abs_nonneg a₂) (le_max_left _ _)
  have ha : |a₁| ≤ max |a₁| |b₁| := le_max_left _ _
  have hb : |b₁| ≤ max |a₁| |b₁| := le_max_right _ _
  have hA : |a₂| ≤ max |a₂| |b₂| := le_max_left _ _
  have hB : |b₂| ≤ max |a₂| |b₂| := le_max_right _ _
  have h1 := abs_le.mp (term_bound (B₆) a₁ b₁ a₂ 5 1 ha hb hA hM hH (by norm_num))
  have h2 := abs_le.mp (term_bound (B₄^2 + B₈) a₁ b₁ a₂ 4 2 ha hb hA hM hH (by norm_num))
  have h3 := abs_le.mp (term_bound (B₄*B₆) a₁ b₁ b₂ 4 2 ha hb hB hM hH (by norm_num))
  have h4 := abs_le.mp (term_bound (4*B₄*B₆) a₁ b₁ a₂ 3 3 ha hb hA hM hH (by norm_num))
  have h5 := abs_le.mp (term_bound (B₄*B₈ + 3*B₆^2) a₁ b₁ b₂ 3 3 ha hb hB hM hH (by norm_num))
  have h6 := abs_le.mp (term_bound (2*B₄*B₈ + 4*B₆^2) a₁ b₁ a₂ 2 4 ha hb hA hM hH (by norm_num))
  have h7 := abs_le.mp (term_bound (5*B₆*B₈) a₁ b₁ b₂ 2 4 ha hb hB hM hH (by norm_num))
  have h8 := abs_le.mp (term_bound (4*B₆*B₈) a₁ b₁ a₂ 1 5 ha hb hA hM hH (by norm_num))
  have h9 := abs_le.mp (term_bound (2*B₈^2) a₁ b₁ b₂ 1 5 ha hb hB hM hH (by norm_num))
  have h10 := abs_le.mp (term_bound (B₈^2) a₁ b₁ a₂ 0 6 ha hb hA hM hH (by norm_num))
  rw [prCertA₁, SprCertA₁, abs_le]
  constructor
  · linarith [h1.1, h2.1, h3.1, h4.1, h5.1, h6.1, h7.1, h8.1, h9.1, h10.1, h1.2, h2.2, h3.2, h4.2, h5.2, h6.2, h7.2, h8.2, h9.2, h10.2]
  · linarith [h1.1, h2.1, h3.1, h4.1, h5.1, h6.1, h7.1, h8.1, h9.1, h10.1, h1.2, h2.2, h3.2, h4.2, h5.2, h6.2, h7.2, h8.2, h9.2, h10.2]

def SprCertA₂ (B₄ B₆ B₈ : ℤ) : ℤ :=
  |1| + |B₄| + |-2*B₄| + |3*B₆| + |-5*B₆| + |2*B₈| + |-3*B₈|

theorem SprCertA₂_nonneg (B₄ B₆ B₈ : ℤ) : 0 ≤ SprCertA₂ B₄ B₆ B₈ := by
  rw [SprCertA₂]
  repeat' apply add_nonneg
  all_goals exact abs_nonneg _

theorem abs_prCertA₂_le (B₄ B₆ B₈ a₁ b₁ a₂ b₂ : ℤ) :
    |prCertA₂ B₄ B₆ B₈ a₁ b₁ a₂ b₂|
      ≤ SprCertA₂ B₄ B₆ B₈ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|) := by
  have hM : (0:ℤ) ≤ max |a₁| |b₁| := le_trans (abs_nonneg a₁) (le_max_left _ _)
  have hH : (0:ℤ) ≤ max |a₂| |b₂| := le_trans (abs_nonneg a₂) (le_max_left _ _)
  have ha : |a₁| ≤ max |a₁| |b₁| := le_max_left _ _
  have hb : |b₁| ≤ max |a₁| |b₁| := le_max_right _ _
  have hA : |a₂| ≤ max |a₂| |b₂| := le_max_left _ _
  have hB : |b₂| ≤ max |a₂| |b₂| := le_max_right _ _
  have h1 := abs_le.mp (term_bound (1) a₁ b₁ a₂ 6 0 ha hb hA hM hH (by norm_num))
  have h2 := abs_le.mp (term_bound (B₄) a₁ b₁ b₂ 5 1 ha hb hB hM hH (by norm_num))
  have h3 := abs_le.mp (term_bound (-2*B₄) a₁ b₁ a₂ 4 2 ha hb hA hM hH (by norm_num))
  have h4 := abs_le.mp (term_bound (3*B₆) a₁ b₁ b₂ 4 2 ha hb hB hM hH (by norm_num))
  have h5 := abs_le.mp (term_bound (-5*B₆) a₁ b₁ a₂ 3 3 ha hb hA hM hH (by norm_num))
  have h6 := abs_le.mp (term_bound (2*B₈) a₁ b₁ b₂ 3 3 ha hb hB hM hH (by norm_num))
  have h7 := abs_le.mp (term_bound (-3*B₈) a₁ b₁ a₂ 2 4 ha hb hA hM hH (by norm_num))
  rw [prCertA₂, SprCertA₂, abs_le]
  constructor
  · linarith [h1.1, h2.1, h3.1, h4.1, h5.1, h6.1, h7.1, h1.2, h2.2, h3.2, h4.2, h5.2, h6.2, h7.2]
  · linarith [h1.1, h2.1, h3.1, h4.1, h5.1, h6.1, h7.1, h1.2, h2.2, h3.2, h4.2, h5.2, h6.2, h7.2]

/-! ### §2 — corner lemmas: certificates transport size control -/

section Corners

variable (B₂ B₄ B₆ B₈ a₁ b₁ a₂ b₂ : ℤ)

private theorem max_sq_eq (x y : ℤ) (hx : 0 ≤ x) (hy : 0 ≤ y) :
    max x y ^ 2 = max (x ^ 2) (y ^ 2) := by
  rcases le_total x y with h | h
  · rw [max_eq_right h, max_eq_right (by nlinarith)]
  · rw [max_eq_left h, max_eq_left (by nlinarith)]

/-- Through the twin certificates, `H₂³·Psi₁²` is controlled by the secant
forms — whichever coordinate realizes `H₂`. -/
theorem corner_psi :
    max |a₂| |b₂| ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2
      ≤ ((SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
          + (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆))
        * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
        * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| := by
  have hM : (0:ℤ) ≤ max |a₁| |b₁| := le_trans (abs_nonneg a₁) (le_max_left _ _)
  have hH : (0:ℤ) ≤ max |a₂| |b₂| := le_trans (abs_nonneg a₂) (le_max_left _ _)
  have hK : (0:ℤ) ≤ max |a₁| |b₁| ^ 6 * max |a₂| |b₂| := by positivity
  have hX : (0:ℤ) ≤ max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| :=
    le_trans (abs_nonneg _) (le_max_left _ _)
  have hDD : |DDz a₁ b₁ a₂ b₂| ≤ max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| :=
    le_max_left _ _
  have hSf : |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| ≤ max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| :=
    le_max_right _ _
  have hb2 : |b₂ ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2|
      ≤ (SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
        * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
        * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| := by
    rw [← psi_sq_cert]
    calc |sfCert₁ B₂ B₄ B₆ a₁ b₁ a₂ b₂ * DDz a₁ b₁ a₂ b₂
          + sfCert₂ B₂ B₄ B₆ a₁ b₁ a₂ b₂ * Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂|
        ≤ |sfCert₁ B₂ B₄ B₆ a₁ b₁ a₂ b₂| * |DDz a₁ b₁ a₂ b₂|
            + |sfCert₂ B₂ B₄ B₆ a₁ b₁ a₂ b₂| * |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| := by
          refine (abs_add _ _).trans ?_
          rw [abs_mul, abs_mul]
      _ ≤ (SsfCert₁ B₂ B₄ B₆ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|))
            * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂|
          + (SsfCert₂ B₂ B₄ B₆ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|))
            * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| := by
          apply add_le_add
          · exact mul_le_mul (abs_sfCert₁_le _ _ _ _ _ _ _) hDD (abs_nonneg _)
              (mul_nonneg (SsfCert₁_nonneg B₂ B₄ B₆) (by positivity))
          · exact mul_le_mul (abs_sfCert₂_le _ _ _ _ _ _ _) hSf (abs_nonneg _)
              (mul_nonneg (SsfCert₂_nonneg B₂ B₄ B₆) (by positivity))
      _ = (SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
            * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
            * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| := by ring
  have ha2 : |a₂ ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2|
      ≤ (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆)
        * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
        * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| := by
    rw [← psi_sq_certA]
    calc |sfCertA₁ B₂ B₄ B₆ a₁ b₁ a₂ b₂ * DDz a₁ b₁ a₂ b₂
          + sfCertA₂ B₂ B₄ B₆ a₁ b₁ a₂ b₂ * Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂|
        ≤ |sfCertA₁ B₂ B₄ B₆ a₁ b₁ a₂ b₂| * |DDz a₁ b₁ a₂ b₂|
            + |sfCertA₂ B₂ B₄ B₆ a₁ b₁ a₂ b₂| * |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| := by
          refine (abs_add _ _).trans ?_
          rw [abs_mul, abs_mul]
      _ ≤ (SsfCertA₁ B₂ B₄ B₆ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|))
            * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂|
          + (SsfCertA₂ B₂ B₄ B₆ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|))
            * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| := by
          apply add_le_add
          · exact mul_le_mul (abs_sfCertA₁_le _ _ _ _ _ _ _) hDD (abs_nonneg _)
              (mul_nonneg (SsfCertA₁_nonneg B₂ B₄ B₆) (by positivity))
          · exact mul_le_mul (abs_sfCertA₂_le _ _ _ _ _ _ _) hSf (abs_nonneg _)
              (mul_nonneg (SsfCertA₂_nonneg B₂ B₄ B₆) (by positivity))
      _ = (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆)
            * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
            * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| := by ring
  have hPsi2 : (0:ℤ) ≤ Psi B₂ B₄ B₆ a₁ b₁ ^ 2 := sq_nonneg _
  rcases max_cases |a₂| |b₂| with ⟨he, _⟩ | ⟨he, _⟩
  · calc max |a₂| |b₂| ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2
        = |a₂ ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2| := by
          rw [abs_mul, abs_pow, abs_of_nonneg hPsi2, he]
      _ ≤ _ := ha2
      _ ≤ _ := by
          apply mul_le_mul_of_nonneg_right _ hX
          apply mul_le_mul_of_nonneg_right _ hK
          have := SsfCert₁_nonneg B₂ B₄ B₆
          have := SsfCert₂_nonneg B₂ B₄ B₆
          linarith
  · calc max |a₂| |b₂| ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2
        = |b₂ ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2| := by
          rw [abs_mul, abs_pow, abs_of_nonneg hPsi2, he]
      _ ≤ _ := hb2
      _ ≤ _ := by
          apply mul_le_mul_of_nonneg_right _ hX
          apply mul_le_mul_of_nonneg_right _ hK
          have := SsfCertA₁_nonneg B₂ B₄ B₆
          have := SsfCertA₂_nonneg B₂ B₄ B₆
          linarith

/-- The `Phi` analogue via `(DDz, Prz)`. -/
theorem corner_phi :
    max |a₂| |b₂| ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2
      ≤ ((SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
          + (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈))
        * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
        * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by
  have hM : (0:ℤ) ≤ max |a₁| |b₁| := le_trans (abs_nonneg a₁) (le_max_left _ _)
  have hH : (0:ℤ) ≤ max |a₂| |b₂| := le_trans (abs_nonneg a₂) (le_max_left _ _)
  have hK : (0:ℤ) ≤ max |a₁| |b₁| ^ 6 * max |a₂| |b₂| := by positivity
  have hX : (0:ℤ) ≤ max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| :=
    le_trans (abs_nonneg _) (le_max_left _ _)
  have hDD : |DDz a₁ b₁ a₂ b₂| ≤ max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| :=
    le_max_left _ _
  have hPr : |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| ≤ max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| :=
    le_max_right _ _
  have hb2 : |b₂ ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2|
      ≤ (SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
        * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
        * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by
    rw [← phi_sq_cert]
    calc |prCert₁ B₄ B₆ B₈ a₁ b₁ a₂ b₂ * DDz a₁ b₁ a₂ b₂
          + prCert₂ B₄ B₆ B₈ a₁ b₁ a₂ b₂ * Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂|
        ≤ |prCert₁ B₄ B₆ B₈ a₁ b₁ a₂ b₂| * |DDz a₁ b₁ a₂ b₂|
            + |prCert₂ B₄ B₆ B₈ a₁ b₁ a₂ b₂| * |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by
          refine (abs_add _ _).trans ?_
          rw [abs_mul, abs_mul]
      _ ≤ (SprCert₁ B₄ B₆ B₈ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|))
            * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂|
          + (SprCert₂ B₄ B₆ B₈ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|))
            * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by
          apply add_le_add
          · exact mul_le_mul (abs_prCert₁_le _ _ _ _ _ _ _) hDD (abs_nonneg _)
              (mul_nonneg (SprCert₁_nonneg B₄ B₆ B₈) (by positivity))
          · exact mul_le_mul (abs_prCert₂_le _ _ _ _ _ _ _) hPr (abs_nonneg _)
              (mul_nonneg (SprCert₂_nonneg B₄ B₆ B₈) (by positivity))
      _ = (SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
            * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
            * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by ring
  have ha2 : |a₂ ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2|
      ≤ (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈)
        * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
        * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by
    rw [← phi_sq_certA]
    calc |prCertA₁ B₄ B₆ B₈ a₁ b₁ a₂ b₂ * DDz a₁ b₁ a₂ b₂
          + prCertA₂ B₄ B₆ B₈ a₁ b₁ a₂ b₂ * Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂|
        ≤ |prCertA₁ B₄ B₆ B₈ a₁ b₁ a₂ b₂| * |DDz a₁ b₁ a₂ b₂|
            + |prCertA₂ B₄ B₆ B₈ a₁ b₁ a₂ b₂| * |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by
          refine (abs_add _ _).trans ?_
          rw [abs_mul, abs_mul]
      _ ≤ (SprCertA₁ B₄ B₆ B₈ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|))
            * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂|
          + (SprCertA₂ B₄ B₆ B₈ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|))
            * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by
          apply add_le_add
          · exact mul_le_mul (abs_prCertA₁_le _ _ _ _ _ _ _) hDD (abs_nonneg _)
              (mul_nonneg (SprCertA₁_nonneg B₄ B₆ B₈) (by positivity))
          · exact mul_le_mul (abs_prCertA₂_le _ _ _ _ _ _ _) hPr (abs_nonneg _)
              (mul_nonneg (SprCertA₂_nonneg B₄ B₆ B₈) (by positivity))
      _ = (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈)
            * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|)
            * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by ring
  have hPhi2 : (0:ℤ) ≤ Phi B₄ B₆ B₈ a₁ b₁ ^ 2 := sq_nonneg _
  rcases max_cases |a₂| |b₂| with ⟨he, _⟩ | ⟨he, _⟩
  · calc max |a₂| |b₂| ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2
        = |a₂ ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2| := by
          rw [abs_mul, abs_pow, abs_of_nonneg hPhi2, he]
      _ ≤ _ := ha2
      _ ≤ _ := by
          apply mul_le_mul_of_nonneg_right _ hX
          apply mul_le_mul_of_nonneg_right _ hK
          have := SprCert₁_nonneg B₄ B₆ B₈
          have := SprCert₂_nonneg B₄ B₆ B₈
          linarith
  · calc max |a₂| |b₂| ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2
        = |b₂ ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2| := by
          rw [abs_mul, abs_pow, abs_of_nonneg hPhi2, he]
      _ ≤ _ := hb2
      _ ≤ _ := by
          apply mul_le_mul_of_nonneg_right _ hX
          apply mul_le_mul_of_nonneg_right _ hK
          have := SprCertA₁_nonneg B₄ B₆ B₈
          have := SprCertA₂_nonneg B₄ B₆ B₈
          linarith

end Corners

/-! ### §3 — THE UNIVERSAL SECANT SIZE LOWER BOUND -/

/-- The combined cofactor constant. -/
def CLsec (B₂ B₄ B₆ B₈ : ℤ) : ℤ :=
  CL B₂ B₄ B₆ B₈ ^ 2
    * (((SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
        + (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆))
      + ((SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
        + (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈)))

/-- **The lower bound**: on every Weierstrass curve, the secant addition
triple is at least `Δ⁴·H₁²H₂²` up to the coefficient constant. -/
theorem secant_size_lower (B₂ B₄ B₆ B₈ : ℤ)
    (hrel : 4 * B₈ = B₂ * B₆ - B₄ ^ 2) (a₁ b₁ a₂ b₂ : ℤ) :
    Disc B₂ B₄ B₆ B₈ ^ 4 * (max |a₁| |b₁| ^ 2 * max |a₂| |b₂| ^ 2)
      ≤ CLsec B₂ B₄ B₆ B₈
        * max (max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂|)
            |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| := by
  set M₁ := max |a₁| |b₁| with hM₁def
  set H₂ := max |a₂| |b₂| with hH₂def
  set MM := max (max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂|)
      |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| with hMMdef
  have hM₁0 : (0:ℤ) ≤ M₁ := le_trans (abs_nonneg a₁) (le_max_left _ _)
  have hH₂0 : (0:ℤ) ≤ H₂ := le_trans (abs_nonneg a₂) (le_max_left _ _)
  have hMM0 : (0:ℤ) ≤ MM :=
    le_trans (abs_nonneg _) (le_trans (le_max_left _ _) (le_max_left _ _))
  have hSΨ0 : (0:ℤ) ≤ (SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
      + (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆) := by
    have := SsfCert₁_nonneg B₂ B₄ B₆
    have := SsfCert₂_nonneg B₂ B₄ B₆
    have := SsfCertA₁_nonneg B₂ B₄ B₆
    have := SsfCertA₂_nonneg B₂ B₄ B₆
    linarith
  have hSΦ0 : (0:ℤ) ≤ (SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
      + (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈) := by
    have := SprCert₁_nonneg B₄ B₆ B₈
    have := SprCert₂_nonneg B₄ B₆ B₈
    have := SprCertA₁_nonneg B₄ B₆ B₈
    have := SprCertA₂_nonneg B₄ B₆ B₈
    linarith
  -- degenerate cases: a factor of the left side vanishes
  rcases eq_or_lt_of_le hM₁0 with hM₁ | hM₁pos
  · have hz : M₁ ^ 2 = 0 := by rw [← hM₁]; ring
    rw [hz]
    calc Disc B₂ B₄ B₆ B₈ ^ 4 * (0 * H₂ ^ 2) = 0 := by ring
      _ ≤ _ := by
        apply mul_nonneg _ hMM0
        rw [CLsec]
        have := sq_nonneg (CL B₂ B₄ B₆ B₈)
        positivity
  rcases eq_or_lt_of_le hH₂0 with hH₂ | hH₂pos
  · have hz : H₂ ^ 2 = 0 := by rw [← hH₂]; ring
    rw [hz]
    calc Disc B₂ B₄ B₆ B₈ ^ 4 * (M₁ ^ 2 * 0) = 0 := by ring
      _ ≤ _ := by
        apply mul_nonneg _ hMM0
        rw [CLsec]
        have := sq_nonneg (CL B₂ B₄ B₆ B₈)
        positivity
  -- the duplication lower bound, squared
  have hdup := disc_sq_mul_le hrel a₁ b₁
  have hdup0 : (0:ℤ) ≤ Disc B₂ B₄ B₆ B₈ ^ 2 * M₁ ^ 4 := by positivity
  have hsq : (Disc B₂ B₄ B₆ B₈ ^ 2 * M₁ ^ 4) ^ 2
      ≤ (CL B₂ B₄ B₆ B₈ * max |Phi B₄ B₆ B₈ a₁ b₁| |Psi B₂ B₄ B₆ a₁ b₁|) ^ 2 :=
    pow_le_pow_left₀ hdup0 hdup 2
  -- max of squares
  have hQ : (max |Phi B₄ B₆ B₈ a₁ b₁| |Psi B₂ B₄ B₆ a₁ b₁|) ^ 2
      = max (Phi B₄ B₆ B₈ a₁ b₁ ^ 2) (Psi B₂ B₄ B₆ a₁ b₁ ^ 2) := by
    rw [max_sq_eq _ _ (abs_nonneg _) (abs_nonneg _), sq_abs, sq_abs]
  -- corner control of the max of squares
  have hMDS : max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| ≤ MM :=
    le_max_left _ _
  have hMDP : max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| ≤ MM := by
    apply max_le
    · exact le_trans (le_max_left _ _) (le_max_left _ _)
    · exact le_max_right _ _
  have hcornerΨ : H₂ ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2
      ≤ ((SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
          + (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆))
        * (M₁ ^ 6 * H₂) * MM := by
    calc H₂ ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2
        ≤ ((SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
            + (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆))
          * (M₁ ^ 6 * H₂)
          * max |DDz a₁ b₁ a₂ b₂| |Sfz B₂ B₄ B₆ a₁ b₁ a₂ b₂| :=
          corner_psi B₂ B₄ B₆ a₁ b₁ a₂ b₂
      _ ≤ _ := by
          apply mul_le_mul_of_nonneg_left hMDS
          positivity
  have hcornerΦ : H₂ ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2
      ≤ ((SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
          + (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈))
        * (M₁ ^ 6 * H₂) * MM := by
    calc H₂ ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2
        ≤ ((SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
            + (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈))
          * (M₁ ^ 6 * H₂)
          * max |DDz a₁ b₁ a₂ b₂| |Prz B₄ B₆ B₈ a₁ b₁ a₂ b₂| :=
          corner_phi B₄ B₆ B₈ a₁ b₁ a₂ b₂
      _ ≤ _ := by
          apply mul_le_mul_of_nonneg_left hMDP
          positivity
  -- combine
  have hSsum : (0:ℤ) ≤ ((SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
      + (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆))
      + ((SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
      + (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈)) := by linarith
  have hQcorner : H₂ ^ 3 * (max |Phi B₄ B₆ B₈ a₁ b₁| |Psi B₂ B₄ B₆ a₁ b₁|) ^ 2
      ≤ (((SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
          + (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆))
        + ((SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
          + (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈)))
        * (M₁ ^ 6 * H₂) * MM := by
    rw [hQ]
    have hK0 : (0:ℤ) ≤ (M₁ ^ 6 * H₂) * MM := by positivity
    rcases max_cases (Phi B₄ B₆ B₈ a₁ b₁ ^ 2) (Psi B₂ B₄ B₆ a₁ b₁ ^ 2)
      with ⟨he, _⟩ | ⟨he, _⟩
    · rw [he]
      calc H₂ ^ 3 * Phi B₄ B₆ B₈ a₁ b₁ ^ 2
          ≤ ((SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
              + (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈))
            * (M₁ ^ 6 * H₂) * MM := hcornerΦ
        _ ≤ _ := by nlinarith [hK0, hSΨ0]
    · rw [he]
      calc H₂ ^ 3 * Psi B₂ B₄ B₆ a₁ b₁ ^ 2
          ≤ ((SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
              + (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆))
            * (M₁ ^ 6 * H₂) * MM := hcornerΨ
        _ ≤ _ := by nlinarith [hK0, hSΦ0]
  -- chain everything and cancel M₁⁶·H₂
  have hCL0 : (0:ℤ) ≤ CL B₂ B₄ B₆ B₈ := CL_nonneg B₂ B₄ B₆ B₈
  have hchain : (M₁ ^ 6 * H₂) * (Disc B₂ B₄ B₆ B₈ ^ 4 * (M₁ ^ 2 * H₂ ^ 2))
      ≤ (M₁ ^ 6 * H₂) * (CLsec B₂ B₄ B₆ B₈ * MM) := by
    have e1 : (M₁ ^ 6 * H₂) * (Disc B₂ B₄ B₆ B₈ ^ 4 * (M₁ ^ 2 * H₂ ^ 2))
        = H₂ ^ 3 * ((Disc B₂ B₄ B₆ B₈ ^ 2 * M₁ ^ 4) ^ 2) := by ring
    have e2 : (M₁ ^ 6 * H₂) * (CLsec B₂ B₄ B₆ B₈ * MM)
        = CL B₂ B₄ B₆ B₈ ^ 2
          * ((((SsfCert₁ B₂ B₄ B₆ + SsfCert₂ B₂ B₄ B₆)
              + (SsfCertA₁ B₂ B₄ B₆ + SsfCertA₂ B₂ B₄ B₆))
            + ((SprCert₁ B₄ B₆ B₈ + SprCert₂ B₄ B₆ B₈)
              + (SprCertA₁ B₄ B₆ B₈ + SprCertA₂ B₄ B₆ B₈)))
            * (M₁ ^ 6 * H₂) * MM) := by
      rw [CLsec]; ring
    rw [e1, e2]
    calc H₂ ^ 3 * ((Disc B₂ B₄ B₆ B₈ ^ 2 * M₁ ^ 4) ^ 2)
        ≤ H₂ ^ 3 * ((CL B₂ B₄ B₆ B₈
            * max |Phi B₄ B₆ B₈ a₁ b₁| |Psi B₂ B₄ B₆ a₁ b₁|) ^ 2) := by
          apply mul_le_mul_of_nonneg_left hsq (by positivity)
      _ = CL B₂ B₄ B₆ B₈ ^ 2
            * (H₂ ^ 3 * (max |Phi B₄ B₆ B₈ a₁ b₁| |Psi B₂ B₄ B₆ a₁ b₁|) ^ 2) := by
          ring
      _ ≤ _ := by
          apply mul_le_mul_of_nonneg_left hQcorner (by positivity)
  have hpos : (0:ℤ) < M₁ ^ 6 * H₂ := by positivity
  exact le_of_mul_le_mul_left hchain hpos

end PrincipiaTractalis.SecantSizeLower

