/-! ### §0 — the termwise bound primitive -/

private theorem term_bound (q u v w : ℤ) (i j : ℕ) {M H : ℤ}
    (hu : |u| ≤ M) (hv : |v| ≤ M) (hw : |w| ≤ H) (hM : 0 ≤ M) (hH : 0 ≤ H)
    (hij : i + j = 6) :
    |q * (u ^ i * v ^ j * w)| ≤ |q| * (M ^ 6 * H) := by
  rw [abs_mul, abs_mul, abs_mul, abs_pow, abs_pow]
  have h1 : |u| ^ i ≤ M ^ i := pow_le_pow_left₀ (abs_nonneg _) hu i
  have h2 : |v| ^ j ≤ M ^ j := pow_le_pow_left₀ (abs_nonneg _) hv j
  calc |q| * (|u| ^ i * |v| ^ j * |w|)
      ≤ |q| * (M ^ i * M ^ j * H) := by
        apply mul_le_mul_of_nonneg_left _ (abs_nonneg q)
        apply mul_le_mul _ hw (abs_nonneg _) (by positivity)
        exact mul_le_mul h1 h2 (by positivity) (by positivity)
    _ = |q| * (M ^ 6 * H) := by rw [← pow_add, hij]

/-! ### §1 — the eight cofactor size bounds (generated) -/

def SsfCert₁ (B₂ B₄ B₆ : ℤ) : ℤ :=
  |16| + |12| + |8*B₂| + |2*B₂| + |B₂^2 + 6*B₄| + |2*B₄| + |2*B₂*B₄ - 2*B₆| + |B₄^2|

theorem SsfCert₁_nonneg (B₂ B₄ B₆ : ℤ) : 0 ≤ SsfCert₁ B₂ B₄ B₆ := by
  rw [SsfCert₁]
  repeat' apply add_nonneg
  all_goals exact abs_nonneg _

theorem abs_sfCert₁_le (B₂ B₄ B₆ a₁ b₁ a₂ b₂ : ℤ) :
    |sfCert₁ B₂ B₄ B₆ a₁ b₁ a₂ b₂|
      ≤ SsfCert₁ B₂ B₄ B₆ * (max |a₁| |b₁| ^ 6 * max |a₂| |b₂|) := by
  have hM : (0:ℤ) ≤ max |a₁| |b₁| := le_trans (abs_nonneg a₁) (le_max_left _ _)
  have hH : (0:ℤ) ≤ max |a₂| |b₂| := le_trans (abs_nonneg a₂) (le_max_left _ _)
  have ha : |a₁| ≤ max |a₁| |b₁| := le_max_left _ _
  have hb : |b₁| ≤ max |a₁| |b₁| := le_max_right _ _
  have hA : |a₂| ≤ max |a₂| |b₂| := le_max_left _ _
  have hB : |b₂| ≤ max |a₂| |b₂| := le_max_right _ _
  have h1 := abs_le.mp (term_bound (16) a₁ b₁ b₂ 4 2 ha hb hB hM hH (by norm_num))
  have h2 := abs_le.mp (term_bound (12) a₁ b₁ a₂ 3 3 ha hb hA hM hH (by norm_num))
  have h3 := abs_le.mp (term_bound (8*B₂) a₁ b₁ b₂ 3 3 ha hb hB hM hH (by norm_num))
  have h4 := abs_le.mp (term_bound (2*B₂) a₁ b₁ a₂ 2 4 ha hb hA hM hH (by norm_num))
  have h5 := abs_le.mp (term_bound (B₂^2 + 6*B₄) a₁ b₁ b₂ 2 4 ha hb hB hM hH (by norm_num))
  have h6 := abs_le.mp (term_bound (2*B₄) a₁ b₁ a₂ 1 5 ha hb hA hM hH (by norm_num))
  have h7 := abs_le.mp (term_bound (2*B₂*B₄ - 2*B₆) a₁ b₁ b₂ 1 5 ha hb hB hM hH (by norm_num))
  have h8 := abs_le.mp (term_bound (B₄^2) a₁ b₁ b₂ 0 6 ha hb hB hM hH (by norm_num))
  rw [sfCert₁, SsfCert₁, abs_le]
  constructor
  · linarith [h1.1, h2.1, h3.1, h4.1, h5.1, h6.1, h7.1, h8.1, h1.2, h2.2, h3.2, h4.2, h5.2, h6.2, h7.2, h8.2]
