-- The Legion verify tree's mathlib is a junction and
-- `Mathlib.Combinatorics.Choose.Basic` is not built in it, so `Nat.choose` is
-- avoided entirely: `rotationPlanes` is defined by its closed form and the
-- parity needed for the division is proved directly.
import PF.KMS.LevelCellsVanishingFraction_r393

set_option autoImplicit false

namespace PrincipiaTractalis.Chaos.RotationPlanes

/-! ## §1 — Counting rotation planes -/

/-- The number of independent **rotation planes** in `n` dimensions: one per
unordered pair of coordinate axes. This is the standard count of generators of
`so(n)`, i.e. of the antisymmetric `n × n` matrices; the identification is
classical and is cited rather than formalized here. Written in closed form
`n(n-1)/2` rather than as `Nat.choose n 2` for import reasons noted above. -/
def rotationPlanes (n : ℕ) : ℕ := n * (n - 1) / 2

@[simp] theorem rotationPlanes_zero : rotationPlanes 0 = 0 := by decide
@[simp] theorem rotationPlanes_one : rotationPlanes 1 = 0 := by decide

/-- **Two dimensions: one rotation plane.** Vorticity is a scalar — there is no
axis to point along. -/
@[simp] theorem rotationPlanes_two : rotationPlanes 2 = 1 := by decide

/-- **Three dimensions: three rotation planes, matching the three directions.**
Vorticity is a vector, and it has an axis. -/
@[simp] theorem rotationPlanes_three : rotationPlanes 3 = 3 := by decide

/-- **Four dimensions: six rotation planes for four directions.** More planes
than directions, so there is again no vorticity vector. -/
@[simp] theorem rotationPlanes_four : rotationPlanes 4 = 6 := by decide

/-! ## §2 — The doubled count, division-free

`C(n,2) = n(n-1)/2` involves truncated division; the doubled identity avoids it
and is what the characterisation below uses. -/

/-- One of `n`, `n - 1` is even, so their product is. -/
theorem two_dvd_mul_pred (n : ℕ) : 2 ∣ n * (n - 1) := by
  rcases Nat.even_or_odd n with h | h
  · exact h.two_dvd.mul_right _
  · exact (Nat.Odd.sub_odd h odd_one).two_dvd.mul_left _

theorem two_mul_rotationPlanes (n : ℕ) :
    2 * rotationPlanes n = n * (n - 1) :=
  Nat.mul_div_cancel' (two_dvd_mul_pred n)

/-! ## §3 — Dimension three is the unique match -/

/-- **★★★ r394: `C(n,2) = n` exactly when `n = 0` or `n = 3` ★★★**

Rotation planes equal directions only in dimension three (ignoring the empty
case). This is the algebraic content of "why three dimensions". -/
theorem rotationPlanes_eq_self_iff (n : ℕ) :
    rotationPlanes n = n ↔ n = 0 ∨ n = 3 := by
  constructor
  · intro h
    have h2 := two_mul_rotationPlanes n
    rw [h] at h2
    cases n with
    | zero => exact Or.inl rfl
    | succ m =>
        refine Or.inr ?_
        simp only [Nat.succ_sub_one] at h2
        -- `2 * (m+1) = (m+1) * m`, cancel `m+1 > 0`
        have hcancel : (m + 1) * 2 = (m + 1) * m := by
          rw [mul_comm (m + 1) 2]; exact h2
        have hm : 2 = m := Nat.eq_of_mul_eq_mul_left (Nat.succ_pos m) hcancel
        omega
  · rintro (rfl | rfl) <;> decide

/-- **★ r394: the trichotomy at 2, 3, 4 ★**

Fewer planes than directions in the plane; equal in space; more in four
dimensions. -/
theorem rotationPlanes_trichotomy :
    rotationPlanes 2 < 2 ∧ rotationPlanes 3 = 3 ∧ 4 < rotationPlanes 4 := by
  refine ⟨?_, rotationPlanes_three, ?_⟩ <;> decide

/-- Dimension three is the unique *positive* dimension where they match. -/
theorem three_unique_positive_match {n : ℕ} (hn : 0 < n)
    (h : rotationPlanes n = n) : n = 3 := by
  rcases (rotationPlanes_eq_self_iff n).mp h with h0 | h3
  · omega
  · exact h3

end PrincipiaTractalis.Chaos.RotationPlanes

