  have hSel : SelmerRankEquals E_102a1 1 := selmerRankEquals_E102a1_at_one
  refine ⟨{ r := 1
            rankWitness := hRW
            lValueWitness := hLV
            selmerWitness := hSel }, rfl⟩

/-! ## §7 — Honest-scope theorem -/

/-- **★ HONEST SCOPE THEOREM ★**. -/
theorem bsd_rank_one_E102a1_honest_scope :
    E_102a1.toAffine.Equation
      heegnerPoint_E102a1.1 heegnerPoint_E102a1.2
    ∧
    E_102a1.toAffine.Equation
      duplicateHeegnerPoint_E102a1.1 duplicateHeegnerPoint_E102a1.2
    ∧
    RankWitnessTyped E_102a1 1
    ∧
    (∀ (_hGZ : GrossZagier1986HeegnerPointNonTorsion)
       (_hK  : Kolyvagin1990HeegnerToRankOne)
       (_hLp : LDerivativeAtOneNonZero E_102a1)
       (_hHH : HeegnerHypothesisSatisfied E_102a1),
         ∃ cert : RankCertificateTyped E_102a1, cert.r = 1)
    ∧
    (∃ cert : RankCertificateTyped E_102a1, cert.r = 1)
    ∧
    E_102a1.Δ = (612 : ℚ) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact heegnerPoint_E102a1_on_curve
  · exact duplicateHeegnerPoint_E102a1_on_curve
  · exact heegnerDerived_rankWitnessTyped_E102a1
  · exact bsd_rank_one_E102a1_via_heegner_and_GZ_K
  · exact bsd_rank_one_E102a1_discharged_at_placeholder
  · exact E_102a1_Δ

