      lDerivativeAtOneNonZero_E102a1 heegnerHypothesisSatisfied_E102a1
  have hLV : LValueAtSEqualsOneVanishesAtOrder E_102a1 1 :=
    kolyvagin1990HeegnerToRankOne_holds_at_True_placeholder
